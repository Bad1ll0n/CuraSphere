# ─────────────────────────────────────────────────────────────────────────────
# OPS-19 — TEMPLATE. A imagem oficial do nginx gera /etc/nginx/nginx.conf a partir daqui no
# arranque (envsubst; ver o serviço `nginx` no docker-compose.prod.yml). Só se substituem
# DOMINIO e TLS_DIR (NGINX_ENVSUBST_FILTER) — as variáveis do nginx ($host, $uri…)
# ficam como estão. O domínio e as redes do hospital já não estão versionados ("ALTERAR"):
# vêm do .env.prod (DOMINIO) e de nginx/rede-interna.conf (fora do repositório).
# ─────────────────────────────────────────────────────────────────────────────
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid       /tmp/nginx.pid;

events {
    worker_connections 1024;
    use epoll;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    # Logs (OPS-07 / SEC-17)
    # JSON, com tempos, estado do upstream e o id do pedido ($request_id), que segue para a API
    # em X-Correlation-Id e volta na resposta: um erro na API e a linha do nginx cruzam-se pelo
    # mesmo id. Regista-se o CAMINHO sem query string (podia levar tokens e ids de doentes) e
    # sem Referer; o token do link de família, que vai no caminho, é mascarado.
    map $uri $uri_registo {
        ~^(?<pre>/familia/)[^/]+        "${pre}***";
        ~^(?<pre>/api/v1/familia/portal/)[^/]+ "${pre}***";
        default                         $uri;
    }
    log_format json escape=json '{'
        '"ts":"$time_iso8601",'
        '"request_id":"$request_id",'
        '"ip":"$remote_addr",'
        '"metodo":"$request_method",'
        '"caminho":"$uri_registo",'
        '"estado":$status,'
        '"bytes":$body_bytes_sent,'
        '"duracao_s":$request_time,'
        '"upstream":"$upstream_addr",'
        '"upstream_estado":"$upstream_status",'
        '"upstream_duracao_s":"$upstream_response_time",'
        '"user_agent":"$http_user_agent"'
    '}';
    access_log /var/log/nginx/access.log json;

    # Performance
    sendfile        on;
    tcp_nopush      on;
    tcp_nodelay     on;
    keepalive_timeout 65;
    gzip            on;
    gzip_types      text/plain text/css application/json application/javascript
                    text/xml application/xml text/javascript image/svg+xml;
    gzip_min_length 1000;

    # Cabeçalhos de segurança: definidos no bloco `server` HTTPS (ver OPS-06 lá).

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api_geral:10m  rate=60r/s;
    limit_req_zone $binary_remote_addr zone=login:10m      rate=5r/m;
    limit_req_zone $binary_remote_addr zone=mfa:10m        rate=10r/m;

    # Upgrade só para WebSocket. Reencaminhar o `Upgrade` do cliente tal como vem deixa
    # passar `Upgrade: h2c`, que abre um túnel HTTP/2 em claro até ao upstream por cima
    # das regras de `location` (h2c smuggling). Qualquer outro valor segue sem upgrade.
    map $http_upgrade $upgrade_websocket {
        ~*^websocket$ websocket;
        default       "";
    }
    map $upgrade_websocket $connection_upgrade {
        websocket upgrade;
        default   "";
    }

    # Ocultar versão do nginx
    server_tokens off;

    # ── Quem chega a quê (OPS-19) ───────────────────────────────────────────
    # Antes havia um `allow`/`deny all` no bloco HTTPS inteiro: fora da LAN/VPN nada passava —
    # incluindo o portal do doente e o acesso da família, que existem precisamente para quem
    # está em casa. Agora a aplicação do PESSOAL continua só para a rede do hospital, e as rotas
    # públicas (portal, família e os recursos estáticos de que precisam) ficam abertas — a API
    # aplica a sua própria autenticação, limites e consentimentos a essas rotas.
    geo $rede_interna {
        default 0;
        127.0.0.1/32 1;                          # o próprio host (healthchecks, deploy)
        include /etc/nginx/rede-interna.conf;    # LAN e VPN do hospital (nginx/rede-interna.conf)
    }
    map $uri $rota_publica {
        default 0;
        ~^/(portal|familia)(/|$)                 1;
        ~^/api/v1/(portal|familia)(/|$)          1;
        ~^/api/v1/csrf-token$                     1;   # o portal pede o token CSRF antes de submeter
        ~^/_next/(static|image)/                 1;
        ~^/(favicon\.ico|manifest\.json|robots\.txt|sw\.js)$ 1;
        ~^/(icons|images|fonts)/                 1;
        ~^/\.well-known/acme-challenge/          1;
    }
    # 1 = recusar: nem rede interna nem rota pública.
    map "$rede_interna:$rota_publica" $acesso_recusado {
        default 1;
        ~^1:     0;
        ~:1$     0;
    }

    # ── Upstreams (OPS-09 / OPS-12) ─────────────────────────────────────────
    # `api` e `web` são resolvidos no DNS do Docker sempre que o nginx carrega a configuração
    # (arranque e `nginx -s reload`), e TODAS as réplicas entram no balanceamento. O nginx só
    # vê a rede `curasphere-lb`, onde as réplicas novas só entram depois de prontas, e o
    # deploy em rolamento (scripts/lib-rolamento.sh) recarrega-o — sem paragem — quando entram
    # as novas e quando saem as antigas. Era a falta dessa recarga que dava 502 depois de um
    # deploy (OPS-12): o nginx continuava a mandar para o IP do contentor antigo.
    #
    # Não se usa `server ... resolve`: no ensaio (scripts/ensaio-rolamento.sh) o nginx manteve
    # os IPs antigos na zona partilhada mesmo depois de recarregar, e houve pedidos perdidos.
    upstream api_curasphere {
        least_conn;
        server api:3333 max_fails=1 fail_timeout=5s;
        keepalive 32;
    }

    upstream web_curasphere {
        least_conn;
        server web:3000 max_fails=1 fail_timeout=5s;
        keepalive 16;
    }

    # Um contentor que acabou de sair deixa de ter IP: sem isto, o nginx esperava 60 s (omissão)
    # a ligar-lhe. Os contentores estão no mesmo host: 2 s chega para ligar a uma réplica viva,
    # e ao falhar o pedido segue para outra (proxy_next_upstream, omissão: error timeout).
    proxy_connect_timeout 2s;

    # ── Redirecionar HTTP → HTTPS ──────────────────────────────────────────
    server {
        listen 80;
        server_name _;
        # OPS-06: healthcheck do contentor (o anterior era `nginx -t`, que só valida a sintaxe).
        # Só responde a pedidos de dentro do contentor; tudo o resto segue para HTTPS.
        location = /healthz {
            access_log off;
            allow 127.0.0.1;
            deny  all;
            return 200 "ok\n";
        }
        # OPS-18: desafio ACME (Let's Encrypt, HTTP-01) — o certbot escreve aqui (volume
        # partilhado) na emissão e em cada renovação. Tem de estar em HTTP: é assim que a CA valida.
        location ^~ /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type text/plain;
            try_files $uri =404;
        }
        location / {
            return 301 https://$host$request_uri;
        }
    }

    # ── HTTPS principal ────────────────────────────────────────────────────
    server {
        listen 443 ssl;
        http2  on;   # `listen ... http2` está obsoleto desde o nginx 1.25.1
        server_name ${DOMINIO};
        # Os `proxy_set_header Host` abaixo usam `$server_name` e não o cabeçalho Host do
        # pedido: este é o único bloco TLS e por isso o default para qualquer Host recebido.

        # ── Restrição de rede (OPS-19) ──────────────────────────────────────
        # A aplicação do pessoal só da LAN/VPN do hospital; portal e família de qualquer lado
        # (ver $acesso_recusado acima). `return` no nível do server corre antes das locations.
        if ($acesso_recusado) {
            return 403;
        }

        # ── Certificado (OPS-18) ────────────────────────────────────────────
        # TLS_DIR: /etc/letsencrypt/live/curasphere (emitido e renovado pelo certbot — ver
        # scripts/emitir-certificado.sh) ou /etc/nginx/ssl (certificado da CA interna do
        # hospital, posto à mão). Em ambos: fullchain.pem, privkey.pem e chain.pem.
        ssl_certificate         ${TLS_DIR}/fullchain.pem;
        ssl_certificate_key     ${TLS_DIR}/privkey.pem;
        ssl_trusted_certificate ${TLS_DIR}/chain.pem;

        # Configuração TLS moderna
        ssl_protocols             TLSv1.2 TLSv1.3;
        ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
        ssl_prefer_server_ciphers off;
        ssl_session_cache         shared:SSL:10m;
        ssl_session_timeout       1d;
        ssl_session_tickets       off;
        # OPS-18: o stapling estava ligado mas não funcionava — sem `resolver` o nginx não
        # consegue chegar ao respondedor OCSP, e sem `ssl_trusted_certificate` não verifica a
        # resposta. 127.0.0.11 é o DNS do Docker, que reencaminha os nomes externos.
        ssl_stapling              on;
        ssl_stapling_verify       on;
        resolver                  127.0.0.11 valid=300s ipv6=off;
        resolver_timeout          5s;

        # ── Cabeçalhos de segurança (OPS-06) ────────────────────────────────
        # O nginx só herda `add_header` do nível de cima quando o nível actual não define
        # NENHUM. Havia quatro no bloco `http` e o HSTS aqui: bastava o HSTS para os outros
        # quatro desaparecerem de todas as respostas. Ficam todos neste nível, e nenhuma
        # `location` abaixo pode usar `add_header` — a que o fizer volta a perder os cinco.
        # HSTS: activar só depois de o SSL estar a funcionar correctamente.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Frame-Options           "SAMEORIGIN"                      always;
        add_header X-Content-Type-Options    "nosniff"                         always;
        add_header X-XSS-Protection          "1; mode=block"                   always;
        add_header Referrer-Policy           "strict-origin-when-cross-origin" always;

        # Tamanho máximo de upload (exames, ficheiros)
        client_max_body_size 50M;

        # ── Auth — rate limit estrito ───────────────────────────────────────
        # OPS-05: a API responde em /v1 (versionamento por URI, main.ts) e os clientes chamam
        # /api/v1/auth/login. Com `location = /api/auth/login` a correspondência exacta nunca
        # acontecia e o login caía no limite geral de 60 pedidos/s. A API tem agora
        # `trust proxy` e conta por IP real, mas este continua a ser o primeiro travão.
        #
        # SEC-08: o Express aceita a mesma rota com barra no fim, e `.../login/` não casava com
        # a correspondência exacta — caía no limite geral. As variantes com barra são recusadas.
        location = /api/v1/auth/login/         { return 404; }
        location = /api/v1/auth/mfa/verificar/ { return 404; }
        location = /api/v1/portal/login/       { return 404; }

        location = /api/v1/auth/login {
            limit_req zone=login burst=3 nodelay;
            limit_req_status 429;
            proxy_pass         http://api_curasphere/v1/auth/login;
            proxy_http_version 1.1;
            proxy_set_header   Host              $server_name;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        location = /api/v1/auth/mfa/verificar {
            limit_req zone=mfa burst=5 nodelay;
            limit_req_status 429;
            proxy_pass         http://api_curasphere/v1/auth/mfa/verificar;
            proxy_http_version 1.1;
            proxy_set_header   Host              $server_name;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # O login do portal do doente é a outra porta de entrada com password.
        location = /api/v1/portal/login {
            limit_req zone=login burst=3 nodelay;
            limit_req_status 429;
            proxy_pass         http://api_curasphere/v1/portal/login;
            proxy_http_version 1.1;
            proxy_set_header   Host              $server_name;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # ── WebSocket (Socket.IO) ───────────────────────────────────────────
        # OPS-04: o cliente liga ao namespace `/ws`, e um namespace não é um caminho — o
        # pedido HTTP sai sempre para `/socket.io/`. Esta location estava em
        # `/api/socket.io/`, onde nenhum pedido chega: o handshake caía no `location /` e ia
        # parar à app Next.js, e os alertas SOS, de sépsis e de SLA nunca chegavam aos postos.
        location /socket.io/ {
            proxy_pass             http://api_curasphere/socket.io/;
            # Upgrade/Connection vêm do map acima (só websocket): o h2c não passa.
            proxy_http_version     1.1;  # nosemgrep
            proxy_set_header       Upgrade    $upgrade_websocket;
            proxy_set_header       Connection $connection_upgrade;
            proxy_set_header       Host       $server_name;
            proxy_set_header       X-Real-IP  $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header       X-Forwarded-For $remote_addr;
            proxy_read_timeout     3600s;
            proxy_send_timeout     3600s;
        }

        # ── API geral ───────────────────────────────────────────────────────
        location /api/ {
            limit_req zone=api_geral burst=100 nodelay;
            proxy_pass         http://api_curasphere/;
            proxy_http_version 1.1;
            proxy_set_header   Host              $server_name;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
            proxy_read_timeout 30s;
        }

        # ── Next.js — ficheiros estáticos (cache longa) ─────────────────────
        location /_next/static/ {
            proxy_pass http://web_curasphere/_next/static/;
            # `expires` já envia Cache-Control com max-age. Um `add_header` aqui apagava os
            # cinco cabeçalhos de segurança destas respostas (ver OPS-06 acima).
            expires    365d;
        }

        # ── Web app (Next.js) ───────────────────────────────────────────────
        location / {
            proxy_pass         http://web_curasphere;
            # Upgrade/Connection vêm do map acima (só websocket): o h2c não passa.
            proxy_http_version 1.1;  # nosemgrep
            proxy_set_header   Upgrade    $upgrade_websocket;
            proxy_set_header   Connection $connection_upgrade;
            proxy_set_header   Host       $server_name;
            proxy_set_header   X-Real-IP  $remote_addr;
            proxy_set_header   X-Correlation-Id  $request_id;  # OPS-07
            proxy_set_header   X-Forwarded-For   $remote_addr;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }
}
