# Scripts de shell correm em Linux — no servidor, e dentro do contentor `backup`, que monta
# ./scripts. Com `core.autocrlf=true`, um checkout em Windows passava-os a CRLF, e o `sh` do
# contentor falha na primeira linha (`set: illegal option -`). Fins de linha fixos em LF.
*.sh          text eol=lf
Dockerfile    text eol=lf
nginx/*.conf  text eol=lf
postgres/*.conf text eol=lf
monitoring/**   text eol=lf

# ARQ-11: o Prisma faz checksum de cada migration.sql — CRLF num checkout em Windows
# mudava o checksum e o `migrate deploy` recusava migrações já aplicadas.
apps/api/prisma/migrations/**/*.sql  text eol=lf
apps/api/prisma/migrations/*.toml    text eol=lf
