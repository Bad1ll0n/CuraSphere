generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Utilizadores ────────────────────────────────────────────────────────────
// Roles e sub-roles são geridas dinamicamente via RoleConfig / SubRoleConfig.
// Os campos role e subRole em Utilizador são strings livres (chave da RoleConfig/SubRoleConfig).

model RoleConfig {
  id        String          @id @default(uuid())
  chave     String          @unique // 'medico', 'enfermeiro', 'ti', etc.
  label     String                  // 'Médico', 'Enfermeiro', 'TI', etc.
  categoria String                  // 'clinico', 'suporte', 'gestao', 'ti'
  ativo     Boolean         @default(true)
  ordem     Int             @default(0)

  subRoles  SubRoleConfig[]

  @@map("roles_config")
}

model SubRoleConfig {
  id        String     @id @default(uuid())
  chave     String     @unique // 'cardiologista', 'it_admin', 'generalista', etc.
  label     String             // 'Cardiologista', 'IT Admin', 'Generalista', etc.
  roleChave String             // chave da role-pai (loose FK a RoleConfig.chave)
  ativo     Boolean    @default(true)
  ordem     Int        @default(0)

  role      RoleConfig @relation(fields: [roleChave], references: [chave])

  @@map("subroles_config")
}

enum Servico {
  internamento
  urgencia
  bloco_operatorio
  consultas_externas
  farmacia
  fisioterapia
  transporte
  administrativo
}

model Utilizador {
  id                String   @id @default(uuid())
  numeroFuncionario String   @unique
  nome              String
  passwordHash      String
  role              String   // chave de RoleConfig (ex: 'medico', 'enfermeiro', 'ti')
  subRole           String?  // chave de SubRoleConfig (ex: 'cardiologista', 'it_admin')
  servico           Servico  @default(internamento)
  ordemExperiencia  Int?     // definida pela chefe de enfermeiros
  equipa            String?  // ex: "A", "B", "C"
  ativo             Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  // Relações existentes
  turnosComoChefe           Turno[]                    @relation("ChefeTurno")
  horariosEntrada           HorarioEntrada[]
  notasTurno                NotaTurno[]
  tarefasCriadas            Tarefa[]                   @relation("TarefaCriadaPor")
  tarefasResponsavel        Tarefa[]                   @relation("TarefaResponsavel")
  medicacoesPrescritas      Medicacao[]                @relation("MedicacaoPrescritor")
  registosMedicacao         RegistoMedicacao[]
  doentesAdmitidos          Doente[]                   @relation("DoenteAdmissao")
  escalas                   Escala[]
  atribuicoesEnfermeiro     AtribuicaoDoente[]
  horariosTurnoProfissional HorarioTurnoProfissional[]
  atribuicoesComoUtilizador AtribuicaoHorarioTurno[]   @relation("AtribuicaoUtilizador")
  atribuicoesFeitas         AtribuicaoHorarioTurno[]   @relation("AtribuicaoAtribuidoPor")
  trocasSolicitadas         PedidoTrocaTurno[]         @relation("TrocaSolicitante")
  trocasRecebidas           PedidoTrocaTurno[]         @relation("TrocaDestinatario")
  trocasAprovadas           PedidoTrocaTurno[]         @relation("TrocaAprovadoPor")
  auditLogs                 AuditLog[]
  sinaisVitaisRegistados    SinalVital[]               @relation("SinaisVitaisRegistados")
  dispositivosTokens        DispositivoToken[]
  avaliacoesRisco           AvaliacaoRisco[]
  sumariosAlta              SumarioAlta[]
  // Novos — Fase 7
  notasClinciasAutor        NotaClinica[]
  escalasClinicasRegistadas EscalaClinica[]
  // Novos — Fase 5
  examesSolicitados         Exame[]                    @relation("ExameSolicitadoPor")
  episodiosTriados          EpisodioUrgencia[]         @relation("EpisodioTriador")
  episodiosMedico           EpisodioUrgencia[]         @relation("EpisodioMedico")
  cirurgiasComoCircurgiao   CirurgiaProgramada[]       @relation("CirurgiaCircurgiao")
  cirurgiasComoAnestesista  CirurgiaProgramada[]       @relation("CirurgiaAnestesista")
  consultas                 Consulta[]
  stockPedidosSolicitados   PedidoFarmacia[]           @relation("PedidoSolicitante")
  stockPedidosProcessados   PedidoFarmacia[]           @relation("PedidoProcessador")
  planosReabilitacao        PlanoReabilitacao[]
  sessoesFisioterapia       SessaoFisioterapia[]
  pedidosInternosSolicitados PedidoInterno[]           @relation("PedidoInternoSolicitante")
  pedidosInternosExecutados  PedidoInterno[]           @relation("PedidoInternoExecutor")
  anunciosPublicados        Anuncio[]
  mensagensEnviadas         MensagemInterna[]          @relation("MensagemRemetente")
  mensagensRecebidas        MensagemInterna[]          @relation("MensagemDestinatario")
  // Novos — Fase 8A
  interconsultasRequisitadas Interconsulta[]           @relation("InterconsultaRequisitante")
  interconsultasRespondidas  Interconsulta[]           @relation("InterconsultaResposta")
  dispositivosInseridos      DispositivoInvasivo[]     @relation("DispositivoInserido")
  // Novos — Fase 8B
  medicacoesValidadas        Medicacao[]               @relation("MedicacaoValidador")
  // Novos — Fase 8B WHO Checklist
  checklistsSignIn           ChecklistCirurgia[]       @relation("ChecklistSignIn")
  checklistsTimeOut          ChecklistCirurgia[]       @relation("ChecklistTimeOut")
  checklistsSignOut          ChecklistCirurgia[]       @relation("ChecklistSignOut")
  // Novos — Fase 8C Sala de Espera
  checkinsRececionados       CheckinSalaEspera[]       @relation("CheckinRececionista")
  checkinsAtendidos          CheckinSalaEspera[]       @relation("CheckinMedico")
  refreshTokens              RefreshToken[]
  incidentesCriados          IncidenteTI[]              @relation("IncidentesCriados")
  incidentesAtribuidos       IncidenteTI[]              @relation("IncidentesAtribuidos")
  pedidosTICriados           PedidoTI[]                 @relation("PedidosTICriados")
  pedidosTIAtribuidos        PedidoTI[]                 @relation("PedidosTIAtribuidos")

  @@map("utilizadores")
}

// ─── Camas ───────────────────────────────────────────────────────────────────

enum EstadoCama {
  livre
  ocupada
  em_limpeza
  reservada
}

model Cama {
  id      String     @id @default(uuid())
  numero  String     @unique
  quarto  String
  estado  EstadoCama @default(livre)

  doente Doente?

  @@map("camas")
}

// ─── Doentes ─────────────────────────────────────────────────────────────────

enum EstadoDoente {
  estavel
  grave
  critico
  alta_prevista
}

model Doente {
  id                   String       @id @default(uuid())
  nome                 String
  dataNascimento       DateTime
  numeroProcesso       String       @unique
  estado               EstadoDoente @default(estavel)
  diagnosticoPrincipal String
  dataAdmissao         DateTime     @default(now())
  dataAltaPrevista     DateTime?
  dataAlta             DateTime?
  ativo                Boolean      @default(true)
  emIsolamento         Boolean      @default(false)
  motivoIsolamento     String?

  camaId               String       @unique
  cama                 Cama         @relation(fields: [camaId], references: [id])

  administrativoAdmissaoId String
  administrativo           Utilizador @relation("DoenteAdmissao", fields: [administrativoAdmissaoId], references: [id])

  // Relações existentes
  atribuicoes         AtribuicaoDoente[]
  atribuicoesHorario  AtribuicaoHorarioTurno[]
  tarefas             Tarefa[]
  medicacoes          Medicacao[]
  registosMedicacao   RegistoMedicacao[]
  notasTurno          NotaTurno[]
  passagensTurno      PassagemTurno[]
  sinaisVitais        SinalVital[]
  alergias            Alergia[]
  contactosEmergencia ContactoEmergencia[]
  alertasClinicos     AlertaClinico[]
  avaliacoesRisco     AvaliacaoRisco[]
  sumarioAlta         SumarioAlta?
  // Novos — Fase 7
  notasClincias       NotaClinica[]
  escalasClinicas     EscalaClinica[]
  // Novos — Fase 5
  exames              Exame[]
  episodiosUrgencia   EpisodioUrgencia[]
  cirurgias           CirurgiaProgramada[]
  consultas           Consulta[]
  planosReabilitacao  PlanoReabilitacao[]
  sessoesFisioterapia SessaoFisioterapia[]
  pedidosInternos     PedidoInterno[]
  // Novos — Fase 8A
  interconsultas      Interconsulta[]
  dispositivosInvasivos DispositivoInvasivo[]

  @@index([ativo])
  @@index([estado])
  @@index([dataAdmissao])
  @@map("doentes")
}

// ─── Turnos e Horários ────────────────────────────────────────────────────────

enum TipoTurno {
  manha
  tarde
  noite
}

model Turno {
  id         String    @id @default(uuid())
  tipo       TipoTurno
  dataInicio DateTime
  dataFim    DateTime

  chefeTurnoId String
  chefeTurno   Utilizador @relation("ChefeTurno", fields: [chefeTurnoId], references: [id])

  atribuicoes            AtribuicaoDoente[]
  horariosEntrada        HorarioEntrada[]
  notasTurno             NotaTurno[]
  tarefas                Tarefa[]
  passagensTurnoAnterior PassagemTurno[] @relation("PassagemTurnoAnterior")
  passagensTurnoAtual    PassagemTurno[] @relation("PassagemTurnoAtual")

  @@map("turnos")
}

model AtribuicaoDoente {
  id           String @id @default(uuid())
  doenteId     String
  enfermeiroId String
  turnoId      String

  doente     Doente     @relation(fields: [doenteId], references: [id])
  enfermeiro Utilizador @relation(fields: [enfermeiroId], references: [id])
  turno      Turno      @relation(fields: [turnoId], references: [id])

  @@unique([doenteId, enfermeiroId, turnoId])
  @@map("atribuicoes_doente")
}

model HorarioEntrada {
  id                 String   @id @default(uuid())
  turnoId            String
  utilizadorId       String
  checkInEm          DateTime @default(now())
  passagemTurnoVista Boolean  @default(false)

  turno      Turno      @relation(fields: [turnoId], references: [id])
  utilizador Utilizador @relation(fields: [utilizadorId], references: [id])

  @@unique([turnoId, utilizadorId])
  @@map("horarios_entrada")
}

model PassagemTurno {
  id              String @id @default(uuid())
  turnoAnteriorId String
  turnoAtualId    String
  doenteId        String

  turnoAnterior Turno  @relation("PassagemTurnoAnterior", fields: [turnoAnteriorId], references: [id])
  turnoAtual    Turno  @relation("PassagemTurnoAtual", fields: [turnoAtualId], references: [id])
  doente        Doente @relation(fields: [doenteId], references: [id])

  @@map("passagens_turno")
}

// ─── Notas Clínicas SOAP ─────────────────────────────────────────────────────

model NotaClinica {
  id        String     @id @default(uuid())
  doenteId  String
  doente    Doente     @relation(fields: [doenteId], references: [id])
  autorId   String
  autor     Utilizador @relation(fields: [autorId], references: [id])
  subjetivo String
  objetivo  String
  avaliacao String
  plano     String
  criadaEm  DateTime   @default(now())
  editadaEm DateTime?

  @@index([doenteId, criadaEm])
  @@map("notas_clinicas")
}

// ─── Escalas Clínicas Especializadas ─────────────────────────────────────────

enum TipoEscalaClinica {
  RASS
  CPOT
  SOFA
  CTG
  Apgar
  PEWS
  FLACC
  Barthel
  FIM
  MRC
  FOIS
  NRS2002
  PHQ9
  GAD7
}

model EscalaClinica {
  id             String            @id @default(uuid())
  doenteId       String
  doente         Doente            @relation(fields: [doenteId], references: [id])
  registadoPorId String
  registadoPor   Utilizador        @relation(fields: [registadoPorId], references: [id])
  tipo           TipoEscalaClinica
  valores        Json
  pontuacao      Int?
  classificacao  String?
  observacoes    String?
  registadaEm    DateTime          @default(now())

  @@index([doenteId, tipo])
  @@map("escalas_clinicas")
}

// ─── Notas de Turno ──────────────────────────────────────────────────────────

model NotaTurno {
  id       String   @id @default(uuid())
  texto    String
  criadaEm DateTime @default(now())

  turnoId  String?
  doenteId String
  autorId  String

  turno  Turno?     @relation(fields: [turnoId], references: [id])
  doente Doente     @relation(fields: [doenteId], references: [id])
  autor  Utilizador @relation(fields: [autorId], references: [id])

  @@map("notas_turno")
}

// ─── Tarefas ─────────────────────────────────────────────────────────────────

enum TipoTarefa {
  clinica
  logistica
}

enum PrioridadeTarefa {
  baixa
  media
  alta
  urgente
}

enum EstadoTarefa {
  pendente
  em_progresso
  concluida
  cancelada
}

model Tarefa {
  id               String           @id @default(uuid())
  descricao        String
  tipo             TipoTarefa
  prioridade       PrioridadeTarefa @default(media)
  estado           EstadoTarefa     @default(pendente)
  prazo            DateTime?
  transitouDeTurno Boolean          @default(false)
  criadaEm         DateTime         @default(now())
  concluidaEm      DateTime?

  doenteId         String
  responsavelId    String?
  grupoResponsavel String?
  criadoPorId      String
  turnoId          String?

  doente      Doente      @relation(fields: [doenteId], references: [id])
  responsavel Utilizador? @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  criadoPor   Utilizador  @relation("TarefaCriadaPor", fields: [criadoPorId], references: [id])
  turno       Turno?      @relation(fields: [turnoId], references: [id])

  @@index([doenteId, estado])
  @@index([responsavelId, estado])
  @@map("tarefas")
}

// ─── Medicação ───────────────────────────────────────────────────────────────

model Medicacao {
  id          String    @id @default(uuid())
  nome        String
  dose        String
  via         String
  frequencia  String
  ativo       Boolean   @default(true)
  iniciadoEm  DateTime  @default(now())
  terminadoEm DateTime?

  doenteId       String
  prescritoPorId String

  estadoValidacao String?   // pendente | aprovada | rejeitada
  validadoPorId   String?
  validadaEm      DateTime?
  motivoRejeicao  String?

  doente       Doente      @relation(fields: [doenteId], references: [id])
  prescritoPor Utilizador  @relation("MedicacaoPrescritor", fields: [prescritoPorId], references: [id])
  validadoPor  Utilizador? @relation("MedicacaoValidador", fields: [validadoPorId], references: [id])
  registos     RegistoMedicacao[]

  @@index([doenteId, ativo])
  @@index([estadoValidacao])
  @@map("medicacoes")
}

model RegistoMedicacao {
  id             String   @id @default(uuid())
  administradoEm DateTime @default(now())
  observacoes    String?

  medicacaoId       String
  doenteId          String
  administradoPorId String

  medicacao       Medicacao  @relation(fields: [medicacaoId], references: [id])
  doente          Doente     @relation(fields: [doenteId], references: [id])
  administradoPor Utilizador @relation(fields: [administradoPorId], references: [id])

  @@map("registos_medicacao")
}

// ─── Escalas ─────────────────────────────────────────────────────────────────

model Escala {
  id          String   @id @default(uuid())
  mes         Int
  ano         Int
  criadaEm   DateTime @default(now())
  criadaPorId String

  criadaPor Utilizador     @relation(fields: [criadaPorId], references: [id])
  turnos    HorarioTurno[]

  @@unique([mes, ano])
  @@map("escalas")
}

model HorarioTurno {
  id      String    @id @default(uuid())
  tipo    TipoTurno
  data    DateTime
  escalId String

  escala        Escala                   @relation(fields: [escalId], references: [id])
  profissionais HorarioTurnoProfissional[]
  atribuicoes   AtribuicaoHorarioTurno[]
  trocas        PedidoTrocaTurno[]       @relation("TrocaTurno")

  @@map("horarios_turno")
}

model HorarioTurnoProfissional {
  horarioTurnoId String
  utilizadorId   String

  horarioTurno HorarioTurno @relation(fields: [horarioTurnoId], references: [id])
  utilizador   Utilizador   @relation(fields: [utilizadorId], references: [id])

  @@id([horarioTurnoId, utilizadorId])
  @@map("horarios_turno_profissionais")
}

enum EstadoPedidoTroca {
  pendente_destinatario
  pendente_chefe
  aprovado
  rejeitado
}

model PedidoTrocaTurno {
  id           String            @id @default(uuid())
  estado       EstadoPedidoTroca @default(pendente_destinatario)
  criadoEm     DateTime          @default(now())
  respondidoEm DateTime?

  solicitanteId  String
  turnoId        String
  destinatarioId String
  aprovadoPorId  String?

  solicitante  Utilizador   @relation("TrocaSolicitante", fields: [solicitanteId], references: [id])
  destinatario Utilizador   @relation("TrocaDestinatario", fields: [destinatarioId], references: [id])
  turno        HorarioTurno @relation("TrocaTurno", fields: [turnoId], references: [id])
  aprovadoPor  Utilizador?  @relation("TrocaAprovadoPor", fields: [aprovadoPorId], references: [id])

  @@map("pedidos_troca_turno")
}

model AtribuicaoHorarioTurno {
  id             String @id @default(uuid())
  horarioTurnoId String
  doenteId       String
  utilizadorId   String
  atribuidoPorId String

  horarioTurno HorarioTurno @relation(fields: [horarioTurnoId], references: [id])
  doente       Doente       @relation(fields: [doenteId], references: [id])
  utilizador   Utilizador   @relation("AtribuicaoUtilizador", fields: [utilizadorId], references: [id])
  atribuidoPor Utilizador   @relation("AtribuicaoAtribuidoPor", fields: [atribuidoPorId], references: [id])

  @@unique([horarioTurnoId, doenteId, utilizadorId])
  @@map("atribuicoes_horario_turno")
}

// ─── Sinais Vitais ────────────────────────────────────────────────────────────

model SinalVital {
  id                    String     @id @default(uuid())
  doenteId              String
  doente                Doente     @relation(fields: [doenteId], references: [id])
  registadoPorId        String
  registadoPor          Utilizador @relation("SinaisVitaisRegistados", fields: [registadoPorId], references: [id])
  data                  DateTime   @default(now())
  pressaoSistolica      Int?
  pressaoDiastolica     Int?
  pulso                 Int?
  temperatura           Float?
  saturacaoO2           Int?
  frequenciaRespiratoria Int?
  peso                  Float?
  notas                 String?

  @@map("sinais_vitais")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(uuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id])
  acao         String
  entidadeId   String?
  entidadeTipo String?
  detalhes     String?
  ip           String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([utilizadorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Alergias ─────────────────────────────────────────────────────────────────

model Alergia {
  id         String   @id @default(uuid())
  doenteId   String
  doente     Doente   @relation(fields: [doenteId], references: [id])
  alergenio  String
  tipo       String
  severidade String
  notas      String?
  criadaEm   DateTime @default(now())

  @@map("alergias")
}

// ─── Contactos de Emergência ──────────────────────────────────────────────────

model ContactoEmergencia {
  id        String  @id @default(uuid())
  doenteId  String
  doente    Doente  @relation(fields: [doenteId], references: [id])
  nome      String
  relacao   String
  telefone  String
  principal Boolean @default(false)

  @@map("contactos_emergencia")
}

// ─── Alertas Clínicos ─────────────────────────────────────────────────────────

model AlertaClinico {
  id       String   @id @default(uuid())
  doenteId String
  doente   Doente   @relation(fields: [doenteId], references: [id])
  tipo     String
  mensagem String
  lido     Boolean  @default(false)
  criadoEm DateTime @default(now())

  @@map("alertas_clinicos")
}

// ─── Avaliações de Risco Clínico ─────────────────────────────────────────────

model AvaliacaoRisco {
  id             String     @id @default(uuid())
  doenteId       String
  doente         Doente     @relation(fields: [doenteId], references: [id])
  tipo           String
  pontuacao      Int
  itens          Json
  risco          String
  registadoPorId String
  registadoPor   Utilizador @relation(fields: [registadoPorId], references: [id])
  criadaEm       DateTime   @default(now())

  @@map("avaliacoes_risco")
}

// ─── Sumário de Alta ──────────────────────────────────────────────────────────

model SumarioAlta {
  id             String     @id @default(uuid())
  doenteId       String     @unique
  doente         Doente     @relation(fields: [doenteId], references: [id])
  motivoAlta     String
  destino        String?
  resumoClinical String
  prescricaoSaida String?
  medicoFamilia  String?
  criadoPorId    String
  criadoPor      Utilizador @relation(fields: [criadoPorId], references: [id])
  criadoEm       DateTime   @default(now())

  @@map("sumarios_alta")
}

// ─── Dispositivos / Push Tokens ───────────────────────────────────────────────

model DispositivoToken {
  id           String     @id @default(uuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id])
  token        String     @unique
  plataforma   String
  criadoEm    DateTime   @default(now())

  @@map("dispositivos_tokens")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FASE 5 — EXPANSÃO HOSPITALAR
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Exames Complementares de Diagnóstico ────────────────────────────────────

enum TipoExame {
  analise_clinica
  rx
  eco
  tc
  rmn
  ecg
  outro
}

enum EstadoExame {
  solicitado
  em_progresso
  resultado_disponivel
  cancelado
}

model Exame {
  id              String      @id @default(uuid())
  doenteId        String
  doente          Doente      @relation(fields: [doenteId], references: [id])
  solicitadoPorId String
  solicitadoPor   Utilizador  @relation("ExameSolicitadoPor", fields: [solicitadoPorId], references: [id])
  tipo            TipoExame
  descricao       String
  urgente         Boolean     @default(false)
  estado          EstadoExame @default(solicitado)
  resultado       String?
  dataResultado   DateTime?
  observacoes     String?
  criadoEm        DateTime    @default(now())

  ficheiros FicheiroExame[]

  @@index([estado, urgente])
  @@index([doenteId, estado])
  @@map("exames")
}

model FicheiroExame {
  id       String @id @default(uuid())
  exameId  String
  exame    Exame  @relation(fields: [exameId], references: [id])
  nome     String
  url      String
  mimeType String

  @@map("ficheiros_exame")
}

// ─── Urgência / Triagem ───────────────────────────────────────────────────────

enum CorTriagem {
  vermelho
  laranja
  amarelo
  verde
  azul
}

enum EstadoEpisodio {
  triagem
  sala_espera
  em_atendimento
  alta_urgencia
  internado
  transferido
}

model EpisodioUrgencia {
  id                String         @id @default(uuid())
  doenteId          String?
  doente            Doente?        @relation(fields: [doenteId], references: [id])
  nomeTemporario    String?
  queixaPrincipal   String
  triagem           CorTriagem
  estadoEpisodio    EstadoEpisodio @default(sala_espera)
  triadoPorId       String
  triadoPor         Utilizador     @relation("EpisodioTriador", fields: [triadoPorId], references: [id])
  medicoResponsavelId String?
  medicoResponsavel Utilizador?    @relation("EpisodioMedico", fields: [medicoResponsavelId], references: [id])
  dataEntrada       DateTime       @default(now())
  dataSaida         DateTime?
  notas             String?
  sinaisVitaisTriagem Json?

  @@map("episodios_urgencia")
}

// ─── Bloco Operatório ────────────────────────────────────────────────────────

enum EstadoCirurgia {
  agendada
  em_curso
  concluida
  cancelada
  adiada
}

model CirurgiaProgramada {
  id                 String         @id @default(uuid())
  doenteId           String
  doente             Doente         @relation(fields: [doenteId], references: [id])
  designacao         String
  dataHora           DateTime
  duracaoPrevista    Int
  sala               String
  estado             EstadoCirurgia @default(agendada)
  cirurgiaoId        String
  cirurgiao          Utilizador     @relation("CirurgiaCircurgiao", fields: [cirurgiaoId], references: [id])
  anestesistaId      String?
  anestesista        Utilizador?    @relation("CirurgiaAnestesista", fields: [anestesistaId], references: [id])
  equipa             Json?
  notasPreOperatorio  String?
  notasPosOperatorio  String?
  complicacoes       String?
  criadoEm           DateTime       @default(now())
  checklist          ChecklistCirurgia?

  @@map("cirurgias_programadas")
}

model ChecklistCirurgia {
  id         String             @id @default(uuid())
  cirurgiaId String             @unique
  cirurgia   CirurgiaProgramada @relation(fields: [cirurgiaId], references: [id])

  signInEm    DateTime?
  signInPorId String?
  signInPor   Utilizador? @relation("ChecklistSignIn", fields: [signInPorId], references: [id])
  signInDados Json?

  timeOutEm    DateTime?
  timeOutPorId String?
  timeOutPor   Utilizador? @relation("ChecklistTimeOut", fields: [timeOutPorId], references: [id])
  timeOutDados Json?

  signOutEm    DateTime?
  signOutPorId String?
  signOutPor   Utilizador? @relation("ChecklistSignOut", fields: [signOutPorId], references: [id])
  signOutDados Json?

  @@map("checklists_cirurgia")
}

// ─── Consultas Externas ───────────────────────────────────────────────────────

enum EstadoConsulta {
  agendada
  realizada
  faltou
  cancelada
}

model Consulta {
  id              String         @id @default(uuid())
  doenteId        String?
  doente          Doente?        @relation(fields: [doenteId], references: [id])
  nomeDoente      String?
  medicoId        String
  medico          Utilizador     @relation(fields: [medicoId], references: [id])
  especialidade   String
  dataHora        DateTime
  duracao         Int            @default(30)
  estado          EstadoConsulta @default(agendada)
  notas           String?
  diagnostico     String?
  proximaConsulta DateTime?
  criadoEm        DateTime       @default(now())

  @@map("consultas")
}

// ─── Sala de Espera ───────────────────────────────────────────────────────────

enum EstadoCheckin {
  aguardando
  em_atendimento
  atendido
  desistiu
  ausente
}

model CheckinSalaEspera {
  id              String         @id @default(uuid())
  nomeDoente      String
  dataNascimento  DateTime?
  numeroUtente    String?
  motivo          String
  prioridade      Int            @default(3)
  estado          EstadoCheckin  @default(aguardando)
  chegadaEm       DateTime       @default(now())
  chamadoEm       DateTime?
  atendidoEm      DateTime?
  rececionistadoPorId String?
  rececionista    Utilizador?    @relation("CheckinRececionista", fields: [rececionistadoPorId], references: [id])
  medicoId        String?
  medico          Utilizador?    @relation("CheckinMedico", fields: [medicoId], references: [id])
  observacoes     String?

  @@index([estado, chegadaEm])
  @@map("checkins_sala_espera")
}

// ─── Farmácia / Stock ─────────────────────────────────────────────────────────

enum TipoStock {
  medicamento
  material
  consumivel
}

enum EstadoPedidoFarmacia {
  pendente
  aprovado
  dispensado
  cancelado
}

model StockItem {
  id               String    @id @default(uuid())
  nome             String
  tipo             TipoStock
  quantidade       Float     @default(0)
  quantidadeMinima Float     @default(0)
  unidade          String
  validade         DateTime?
  servico          String
  criadoEm         DateTime  @default(now())

  pedidos PedidoFarmacia[]

  @@map("stock_items")
}

model PedidoFarmacia {
  id              String               @id @default(uuid())
  stockItemId     String
  stockItem       StockItem            @relation(fields: [stockItemId], references: [id])
  quantidade      Float
  servico         String
  estado          EstadoPedidoFarmacia @default(pendente)
  solicitadoPorId String
  solicitadoPor   Utilizador           @relation("PedidoSolicitante", fields: [solicitadoPorId], references: [id])
  processadoPorId String?
  processadoPor   Utilizador?          @relation("PedidoProcessador", fields: [processadoPorId], references: [id])
  observacoes     String?
  criadoEm        DateTime             @default(now())

  @@map("pedidos_farmacia")
}

// ─── Fisioterapia / Reabilitação ──────────────────────────────────────────────

model PlanoReabilitacao {
  id               String   @id @default(uuid())
  doenteId         String
  doente           Doente   @relation(fields: [doenteId], references: [id])
  fisioterapeutaId String
  fisioterapeuta   Utilizador @relation(fields: [fisioterapeutaId], references: [id])
  objetivos        String
  dataInicio       DateTime
  dataFimPrevista  DateTime?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  sessoes SessaoFisioterapia[]

  @@map("planos_reabilitacao")
}

enum EstadoSessao {
  agendada
  realizada
  cancelada
  faltou
}

model SessaoFisioterapia {
  id               String       @id @default(uuid())
  planoId          String
  plano            PlanoReabilitacao @relation(fields: [planoId], references: [id])
  doenteId         String
  doente           Doente       @relation(fields: [doenteId], references: [id])
  fisioterapeutaId String
  fisioterapeuta   Utilizador   @relation(fields: [fisioterapeutaId], references: [id])
  data             DateTime
  duracao          Int
  descricao        String
  evolucao         String?
  estado           EstadoSessao @default(agendada)

  @@map("sessoes_fisioterapia")
}

// ─── Pedidos Internos ────────────────────────────────────────────────────────

enum TipoPedidoInterno {
  transporte
  esterilizacao
  equipamento
  limpeza
}

enum EstadoPedidoInterno {
  pendente
  em_curso
  concluido
  cancelado
}

model PedidoInterno {
  id              String              @id @default(uuid())
  tipo            TipoPedidoInterno
  doenteId        String?
  doente          Doente?             @relation(fields: [doenteId], references: [id])
  localOrigem     String?
  localDestino    String?
  descricao       String
  prioridade      PrioridadeTarefa
  estado          EstadoPedidoInterno @default(pendente)
  solicitadoPorId String
  solicitadoPor   Utilizador          @relation("PedidoInternoSolicitante", fields: [solicitadoPorId], references: [id])
  executadoPorId  String?
  executadoPor    Utilizador?         @relation("PedidoInternoExecutor", fields: [executadoPorId], references: [id])
  servicoOrigem   String
  criadoEm        DateTime            @default(now())
  concluidoEm     DateTime?

  @@map("pedidos_internos")
}

// ─── Comunicação Interna ──────────────────────────────────────────────────────

model Anuncio {
  id       String    @id @default(uuid())
  autorId  String
  autor    Utilizador @relation(fields: [autorId], references: [id])
  titulo   String
  texto    String
  servico  String?
  ativo    Boolean   @default(true)
  criadoEm DateTime  @default(now())
  expiraEm DateTime?

  @@map("anuncios")
}

model MensagemInterna {
  id             String     @id @default(uuid())
  remetenteId    String
  remetente      Utilizador @relation("MensagemRemetente", fields: [remetenteId], references: [id])
  destinatarioId String
  destinatario   Utilizador @relation("MensagemDestinatario", fields: [destinatarioId], references: [id])
  assunto        String?
  texto          String
  lida           Boolean    @default(false)
  criadaEm      DateTime   @default(now())

  @@map("mensagens_internas")
}

// ─── Interconsultas ──────────────────────────────────────────────────────────

enum EstadoInterconsulta {
  pendente
  aceite
  respondida
  cancelada
}

model Interconsulta {
  id                String               @id @default(uuid())
  doenteId          String
  doente            Doente               @relation(fields: [doenteId], references: [id])
  requisitanteId    String
  requisitante      Utilizador           @relation("InterconsultaRequisitante", fields: [requisitanteId], references: [id])
  especialidadeAlvo String
  motivo            String
  urgente           Boolean              @default(false)
  estado            EstadoInterconsulta  @default(pendente)
  medicoRespostaId  String?
  medicoResposta    Utilizador?          @relation("InterconsultaResposta", fields: [medicoRespostaId], references: [id])
  resposta          String?
  criadaEm          DateTime             @default(now())
  respondidaEm      DateTime?

  @@index([doenteId])
  @@index([especialidadeAlvo, estado])
  @@index([requisitanteId, estado])
  @@map("interconsultas")
}

// ─── Dispositivos Invasivos ──────────────────────────────────────────────────

enum TipoDispositivoInvasivo {
  cateter_venoso_central
  cateter_venoso_periferico
  cateter_arterial
  sonda_vesical
  tubo_orotaqueal
  traqueostomia
  dreno_toracico
  sonda_nasogastrica
  linha_epidural
  outro
}

model DispositivoInvasivo {
  id            String                  @id @default(uuid())
  doenteId      String
  doente        Doente                  @relation(fields: [doenteId], references: [id])
  tipo          TipoDispositivoInvasivo
  localizacao   String?
  dataInsercao  DateTime                @default(now())
  dataRemocao   DateTime?
  ativo         Boolean                 @default(true)
  observacoes   String?
  inseridoPorId String
  inseridoPor   Utilizador              @relation("DispositivoInserido", fields: [inseridoPorId], references: [id])

  @@index([doenteId, ativo])
  @@map("dispositivos_invasivos")
}

// ─── Incidentes TI ───────────────────────────────────────────────────────────

enum TipoIncidenteTI {
  infraestrutura
  rede
  his_erp
  base_dados
  seguranca
  dados_clinicos
  outro
}

enum EstadoIncidenteTI {
  aberto
  em_analise
  resolvido
  fechado
}

enum PrioridadeIncidenteTI {
  baixa
  media
  alta
  critica
}

model IncidenteTI {
  id            String                @id @default(uuid())
  titulo        String
  descricao     String
  tipo          TipoIncidenteTI
  subRoleAlvo   String?
  prioridade    PrioridadeIncidenteTI @default(media)
  estado        EstadoIncidenteTI     @default(aberto)
  criadoPorId   String
  criadoPor     Utilizador            @relation("IncidentesCriados", fields: [criadoPorId], references: [id])
  responsavelId String?
  responsavel   Utilizador?           @relation("IncidentesAtribuidos", fields: [responsavelId], references: [id])
  criadoEm     DateTime              @default(now())
  atualizadoEm DateTime              @updatedAt

  @@index([estado])
  @@index([subRoleAlvo])
  @@map("incidentes_ti")
}

// ─── Pedidos TI ───────────────────────────────────────────────────────────────

enum TipoPedidoTI {
  listagem_dados
  relatorio
  acesso_sistema
  backup
  auditoria_dados
  outro
}

enum EstadoPedidoTI {
  pendente
  em_curso
  concluido
  recusado
}

model PedidoTI {
  id            String         @id @default(cuid())
  titulo        String
  descricao     String
  tipo          TipoPedidoTI
  estado        EstadoPedidoTI @default(pendente)
  urgente       Boolean        @default(false)
  criadoEm      DateTime       @default(now())
  resolvidoEm   DateTime?

  criadoPorId   String
  criadoPor     Utilizador  @relation("PedidosTICriados", fields: [criadoPorId], references: [id])

  responsavelId String?
  responsavel   Utilizador? @relation("PedidosTIAtribuidos", fields: [responsavelId], references: [id])

  @@index([estado])
  @@index([criadoPorId])
  @@map("pedidos_ti")
}

// ─── Refresh Tokens ──────────────────────────────────────────────────────────

model RefreshToken {
  id           String     @id @default(uuid())
  token        String     @unique
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revogado     Boolean    @default(false)
  criadoEm    DateTime   @default(now())

  @@index([utilizadorId])
  @@index([token])
  @@map("refresh_tokens")
}
