# Base de dados PostgreSQL
# connection_limit: máximo de conexões por worker NestJS (ajustar conforme nº de workers)
# pool_timeout: segundos de espera por conexão livre antes de lançar erro
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/enfermaria?schema=public&connection_limit=25&pool_timeout=10"

# JWT — OBRIGATÓRIO em produção
# Gerar com:  openssl rand -hex 32
# A API recusa arrancar se o secret for o placeholder ou tiver < 32 caracteres
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32_to_generate_strong_secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — domínios autorizados (separados por vírgula)
# Em produção DEVE ser definido. Sem este valor só localhost é permitido.
ALLOWED_ORIGINS="https://curasphere.hospital.pt"

# Redis (cache + anti-replay TOTP). Em prod usar redis://redis:6379
REDIS_URL="redis://localhost:6379"

# App
PORT=3333
NODE_ENV=development

# Logs coloridos/legíveis no terminal (só funciona correndo via ts-node/nx serve
# directamente — não activar num build empacotado com webpack/Docker, o
# transporte de worker-thread do pino-pretty falha nesse contexto)
LOG_PRETTY=false

# Seed admin (apenas para correr `npx ts-node src/seed.ts` localmente)
# SEED_PASSWORD="GerarUmaPasswordForte_NaoUsarEmProducao"

# Geofencing para verificação de check-in de turnos
# Coordenadas do hospital — obrigatório para validação de presença
HOSPITAL_LAT=38.7223
HOSPITAL_LON=-9.1393
HOSPITAL_GEOFENCE_METROS=300

# Email transacional (Resend — https://resend.com)
# Obrigatório para relatórios agendados e notificações por email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_DOMAIN=curasphere.pt

# Sentry — monitorização de erros em produção (opcional em dev)
SENTRY_DSN=

# Encriptação de dados PII (OBRIGATÓRIO — AES-256-GCM)
# Gerar com: openssl rand -hex 32
# Exactamente 64 caracteres hexadecimais (= 32 bytes)
ENCRYPTION_KEY=

# Jitsi Meet — servidor de teleconsulta
# NUNCA usar meet.jit.si em produção (dados de saúde devem permanecer no servidor do hospital)
JITSI_SERVER=https://jitsi.hospital.pt

# HL7 v2 integration token (OBRIGATÓRIO se integração HL7 activa)
# Sem este valor qualquer cliente pode enviar mensagens HL7
HL7_API_TOKEN=

# OpenAI — embeddings para pesquisa de guidelines clínicas (opcional)
OPENAI_API_KEY=

# Anthropic (Claude) — OBRIGATÓRIO para IA clínica (observações, medicação, feridas,
# stewardship antimicrobiano, guidelines). O SDK lê esta variável automaticamente
# (new Anthropic() sem apiKey explícita) — usado em ai-clinico, guidelines, feridas,
# medicacao e stewardship services.
ANTHROPIC_API_KEY=

# URL pública da API — usada no report-uri do CSP
API_URL=https://api.curasphere.hospital.pt

# URL pública da API tal como vista pelo browser — usada para derivar o rpID
# (hostname) do WebAuthn/FIDO2 (ver auth/webauthn/webauthn.service.ts). Sem isto
# em produção, o rpID cai para 'localhost' e a cerimónia de passkey falha
# (fail-safe, mas passkeys ficam inutilizáveis).
NEXT_PUBLIC_API_URL=https://api.curasphere.hospital.pt

# URL pública do frontend web — usada para redirects após SSO (SAML/OIDC) e como
# 'origin' esperado do WebAuthn. OBRIGATÓRIO em produção; sem isto os fluxos de
# login redirecionam para localhost:4200.
NEXT_PUBLIC_WEB_URL=https://curasphere.hospital.pt

# SPMS / SNS integração — deixar vazio para usar dados demo locais
SPMS_API_URL=https://api-staging.spms.min-saude.pt
SPMS_API_KEY=

# Segredo para tokens JWT de longa duração do quiosque de doente (modo corredor)
# OBRIGATÓRIO se a funcionalidade de quiosque estiver activa — a API lança erro sem isto
# Gerar com: openssl rand -hex 32
QUIOSQUE_SECRET=

# Armazenamento de documentos/ficheiros — "local" (default, disco do container) ou "s3"/"minio"
STORAGE_PROVIDER=local
# Configuração S3/MinIO — só necessária se STORAGE_PROVIDER=s3 ou minio
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=curasphere
AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — alternativa a MINIO_ACCESS_KEY/MINIO_SECRET_KEY
# quando se usa AWS S3 real em vez de MinIO self-hosted
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
