# Base de dados PostgreSQL
# connection_limit: máximo de conexões por worker NestJS (ajustar conforme nº de workers)
# pool_timeout: segundos de espera por conexão livre antes de lançar erro
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/enfermaria?schema=public&connection_limit=25&pool_timeout=10"

# JWT — OBRIGATÓRIO em produção
# Gerar com:  openssl rand -hex 32
# A API recusa arrancar se o secret for o placeholder ou tiver < 32 caracteres
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32_to_generate_strong_secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS — domínios autorizados (separados por vírgula)
# Em produção DEVE ser definido. Sem este valor só localhost é permitido.
ALLOWED_ORIGINS="https://curasphere.hospital.pt"

# Redis (cache + anti-replay TOTP). Em prod usar redis://redis:6379
REDIS_URL="redis://localhost:6379"

# App
PORT=3333
NODE_ENV=development

# Seed admin (apenas para correr `npx ts-node src/seed.ts` localmente)
# SEED_PASSWORD="GerarUmaPasswordForte_NaoUsarEmProducao"

# Geofencing para verificação de check-in de turnos
# Coordenadas do hospital — obrigatório para validação de presença
HOSPITAL_LAT=38.7223
HOSPITAL_LON=-9.1393
HOSPITAL_GEOFENCE_METROS=300

# Email transacional (Resend — https://resend.com)
# Obrigatório para relatórios agendados e notificações por email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_DOMAIN=curasphere.pt

# Sentry — monitorização de erros em produção (opcional em dev)
SENTRY_DSN=

# Encriptação de dados PII (OBRIGATÓRIO — AES-256-GCM)
# Gerar com: openssl rand -hex 32
# Exactamente 64 caracteres hexadecimais (= 32 bytes)
ENCRYPTION_KEY=

# Jitsi Meet — servidor de teleconsulta
# NUNCA usar meet.jit.si em produção (dados de saúde devem permanecer no servidor do hospital)
JITSI_SERVER=https://jitsi.hospital.pt

# HL7 v2 integration token (OBRIGATÓRIO se integração HL7 activa)
# Sem este valor qualquer cliente pode enviar mensagens HL7
HL7_API_TOKEN=

# OpenAI — embeddings para pesquisa de guidelines clínicas (opcional)
OPENAI_API_KEY=

# URL pública da API — usada no report-uri do CSP
API_URL=https://api.curasphere.hospital.pt

# SPMS / SNS integração — deixar vazio para usar dados demo locais
SPMS_API_URL=https://api-staging.spms.min-saude.pt
SPMS_API_KEY=
