generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Utilizadores ────────────────────────────────────────────────────────────
// Roles e sub-roles são geridas dinamicamente via RoleConfig / SubRoleConfig.
// Os campos role e subRole em Utilizador são strings livres (chave da RoleConfig/SubRoleConfig).

model RoleConfig {
  id        String          @id @default(uuid())
  chave     String          @unique // 'medico', 'enfermeiro', 'ti', etc.
  label     String                  // 'Médico', 'Enfermeiro', 'TI', etc.
  categoria String                  // 'clinico', 'suporte', 'gestao', 'ti'
  ativo     Boolean         @default(true)
  ordem     Int             @default(0)

  subRoles  SubRoleConfig[]

  @@map("roles_config")
}

model SubRoleConfig {
  id        String     @id @default(uuid())
  chave     String     @unique // 'cardiologista', 'it_admin', 'generalista', etc.
  label     String             // 'Cardiologista', 'IT Admin', 'Generalista', etc.
  roleChave String             // chave da role-pai (loose FK a RoleConfig.chave)
  ativo     Boolean    @default(true)
  ordem     Int        @default(0)

  role      RoleConfig @relation(fields: [roleChave], references: [chave], onDelete: Cascade)

  @@map("subroles_config")
}

enum Servico {
  internamento
  urgencia
  bloco_operatorio
  consultas_externas
  farmacia
  fisioterapia
  transporte
  administrativo
}

model Utilizador {
  id                String   @id @default(uuid())
  numeroFuncionario String   @unique
  nome              String
  passwordHash      String
  mfaSecret           String?
  mfaAtivo            Boolean   @default(false)
  passwordExpiresAt   DateTime?
  role                String    // chave de RoleConfig (ex: 'medico', 'enfermeiro', 'ti')
  subRole           String?  // chave de SubRoleConfig (ex: 'cardiologista', 'it_admin')
  servico           Servico  @default(internamento)
  ordemExperiencia  Int?     // definida pela chefe de enfermeiros
  equipa            String?  // ex: "A", "B", "C"
  ativo             Boolean  @default(true)
  criadoEm         DateTime @default(now())
  atualizadoEm     DateTime @updatedAt

  // Relações existentes
  turnosComoChefe           Turno[]                    @relation("ChefeTurno")
  horariosEntrada           HorarioEntrada[]
  notasTurno                NotaTurno[]
  tarefasCriadas            Tarefa[]                   @relation("TarefaCriadaPor")
  tarefasResponsavel        Tarefa[]                   @relation("TarefaResponsavel")
  medicacoesPrescritas      Medicacao[]                @relation("MedicacaoPrescritor")
  registosMedicacao         RegistoMedicacao[]
  doentesAdmitidos          Doente[]                   @relation("DoenteAdmissao")
  escalas                   Escala[]
  atribuicoesEnfermeiro     AtribuicaoDoente[]
  horariosTurnoProfissional HorarioTurnoProfissional[]
  atribuicoesComoUtilizador AtribuicaoHorarioTurno[]   @relation("AtribuicaoUtilizador")
  atribuicoesFeitas         AtribuicaoHorarioTurno[]   @relation("AtribuicaoAtribuidoPor")
  trocasSolicitadas         PedidoTrocaTurno[]         @relation("TrocaSolicitante")
  trocasRecebidas           PedidoTrocaTurno[]         @relation("TrocaDestinatario")
  trocasAprovadas           PedidoTrocaTurno[]         @relation("TrocaAprovadoPor")
  auditLogs                 AuditLog[]
  sinaisVitaisRegistados    SinalVital[]               @relation("SinaisVitaisRegistados")
  dispositivosTokens        DispositivoToken[]
  notificacoesInApp         NotificacaoInApp[]
  avaliacoesRisco           AvaliacaoRisco[]
  sumariosAlta              SumarioAlta[]
  // Novos — Fase 7
  notasClinciasAutor        NotaClinica[]
  escalasClinicasRegistadas EscalaClinica[]
  // Novos — Fase 5
  examesSolicitados         Exame[]                    @relation("ExameSolicitadoPor")
  episodiosTriados          EpisodioUrgencia[]         @relation("EpisodioTriador")
  episodiosMedico           EpisodioUrgencia[]         @relation("EpisodioMedico")
  cirurgiasComoCircurgiao   CirurgiaProgramada[]       @relation("CirurgiaCircurgiao")
  cirurgiasComoAnestesista  CirurgiaProgramada[]       @relation("CirurgiaAnestesista")
  consultas                 Consulta[]
  stockPedidosSolicitados   PedidoFarmacia[]           @relation("PedidoSolicitante")
  stockPedidosProcessados   PedidoFarmacia[]           @relation("PedidoProcessador")
  stockPedidosAprovados     PedidoFarmacia[]           @relation("PedidoAprovador")
  planosReabilitacao        PlanoReabilitacao[]
  sessoesFisioterapia       SessaoFisioterapia[]
  pedidosInternosSolicitados PedidoInterno[]           @relation("PedidoInternoSolicitante")
  pedidosInternosExecutados  PedidoInterno[]           @relation("PedidoInternoExecutor")
  anunciosPublicados        Anuncio[]
  mensagensEnviadas         MensagemInterna[]          @relation("MensagemRemetente")
  mensagensRecebidas        MensagemInterna[]          @relation("MensagemDestinatario")
  // Novos — Fase 8A
  interconsultasRequisitadas Interconsulta[]           @relation("InterconsultaRequisitante")
  interconsultasRespondidas  Interconsulta[]           @relation("InterconsultaResposta")
  dispositivosInseridos      DispositivoInvasivo[]     @relation("DispositivoInserido")
  // Novos — Fase 8B
  medicacoesValidadas        Medicacao[]               @relation("MedicacaoValidador")
  // Novos — Fase 8B WHO Checklist
  checklistsSignIn           ChecklistCirurgia[]       @relation("ChecklistSignIn")
  checklistsTimeOut          ChecklistCirurgia[]       @relation("ChecklistTimeOut")
  checklistsSignOut          ChecklistCirurgia[]       @relation("ChecklistSignOut")
  // Novos — Fase 8C Sala de Espera
  checkinsRececionados       CheckinSalaEspera[]       @relation("CheckinRececionista")
  checkinsAtendidos          CheckinSalaEspera[]       @relation("CheckinMedico")
  refreshTokens              RefreshToken[]
  incidentesCriados          IncidenteTI[]              @relation("IncidentesCriados")
  incidentesAtribuidos       IncidenteTI[]              @relation("IncidentesAtribuidos")
  pedidosTICriados           PedidoTI[]                 @relation("PedidosTICriados")
  pedidosTIAtribuidos        PedidoTI[]                 @relation("PedidosTIAtribuidos")
  ficheirosPessoaisAtualizados FicheiroPessoalDoente[]
  episodiosFaturacaoCriados  EpisodioFaturacao[]
  pagamentosRegistados       Pagamento[]
  agendas                    AgendaMedico[]             @relation("AgendaMedico")
  problemasRegistados        ProblemaClinico[]          @relation("ProblemaRegistado")
  manutencoesReportadas      Manutencao[]               @relation("ManutencaoReportada")
  manutencoesTecnico         Manutencao[]               @relation("ManutencaoTecnico")
  alertasAcusados            AlertaClinico[]            @relation("AlertaAcusador")
  // RH
  ausencias                  Ausencia[]                 @relation("AusenciaUtilizador")
  ausenciasAprovadas         Ausencia[]                 @relation("AusenciaAprovador")
  formacoes                  FormacaoUtilizador[]       @relation("FormacaoUtilizador")
  eventosAdversosRegistados  EventoAdverso[]            @relation("EventoAdversoRegistado")
  // Especialidades
  sessoesEspecialidade       SessaoEspecialidade[]      @relation("SessaoEspecialidadeProfissional")
  // RH expandido
  avaliacoesComoAvaliado     AvaliacaoDesempenho[]      @relation("AvaliacaoAvaliado")
  avaliacoesComoAvaliador    AvaliacaoDesempenho[]      @relation("AvaliacaoAvaliador")
  dadosContratuais           DadosContratuais?
  // Chefe directo (hierarquia para aprovação de férias)
  chefeId                    String?
  chefe                      Utilizador?                @relation("ChefeSubordinado", fields: [chefeId], references: [id], onDelete: SetNull)
  subordinados               Utilizador[]               @relation("ChefeSubordinado")
  // Inventário expandido
  ajustesStock               AjusteStock[]              @relation("AjustesFeitos")
  transferenciasSolicitadas  TransferenciaStock[]       @relation("TransfSolicitadas")
  transferenciasConfirmadas  TransferenciaStock[]       @relation("TransfConfirmadas")
  encomendasRecebidas        EncomendaFornecedor[]      @relation("EncomendasRecebidas")
  presencaOnline             PresencaOnline?
  registosCheckin            RegistoCheckin[]
  consentimentosCriados      ConsentimentoInformado[] @relation("ConsentimentoCriador")
  consentimentosTestemunha   ConsentimentoInformado[] @relation("ConsentimentoTestemunha")
  breakGlassUsados           BreakGlassAccess[]
  protocolosAtivados         ProtocoloClinico[]
  itensProtocoloConcluidos   ItemProtocolo[]
  prescricoesDietaCriadas    PrescricaoDieta[]
  medicacoesAssinadas        Medicacao[]              @relation("MedicacaoAssinatura")
  notasAssinadas             NotaClinica[]            @relation("NotaAssinatura")
  culturasRegistadas         CulturaMicrobiologica[]
  surtosRegistados           SurtoIACS[]
  notasIncidentesTI          NotaIncidenteTI[]          @relation("NotasIncidentesTI")
  checklistsConformidade     ConformidadeChecklistItem[] @relation("ChecklistAtualizador")
  // Trocas de folga
  trocasFolgaSolicitadas     TrocaFolga[]               @relation("TrocaFolgaSolicitante")
  trocasFolgaRecebidas       TrocaFolga[]               @relation("TrocaFolgaDestinatario")
  trocasFolgaAprovadas       TrocaFolga[]               @relation("TrocaFolgaAprovador")

  @@index([role, ativo])
  @@index([servico])
  @@map("utilizadores")
}

// ─── Camas ───────────────────────────────────────────────────────────────────

enum EstadoCama {
  livre
  ocupada
  em_limpeza
  reservada
}

model Cama {
  id       String     @id @default(uuid())
  numero   String     @unique
  quarto   String
  estado   EstadoCama @default(livre)
  servico  String?
  piso     Int?

  doente Doente?

  @@index([quarto, estado])
  @@index([servico, estado])
  @@map("camas")
}

// ─── Doentes ─────────────────────────────────────────────────────────────────

enum EstadoDoente {
  estavel
  grave
  critico
  alta_prevista
}

model Doente {
  id                   String       @id @default(uuid())
  nome                 String
  dataNascimento       DateTime?
  numeroProcesso       String       @unique
  estado               EstadoDoente @default(estavel)
  diagnosticoPrincipal String?
  estadoRegisto        String       @default("pendente_cama") // 'pendente_cama' | 'internado' | 'ambulatorio'
  tipoVisita           String?      // 'consulta' | 'exame' | 'urgencia' | 'farmacia' | 'internamento' | 'outro'
  dataAdmissao         DateTime     @default(now())
  dataAltaPrevista     DateTime?
  dataAlta             DateTime?
  ativo                Boolean      @default(true)
  emIsolamento         Boolean      @default(false)
  motivoIsolamento     String?
  deletedAt            DateTime?

  camaId               String?      @unique
  cama                 Cama?        @relation(fields: [camaId], references: [id], onDelete: SetNull)

  administrativoAdmissaoId String?
  administrativo           Utilizador? @relation("DoenteAdmissao", fields: [administrativoAdmissaoId], references: [id], onDelete: SetNull)

  // Relações existentes
  atribuicoes         AtribuicaoDoente[]
  atribuicoesHorario  AtribuicaoHorarioTurno[]
  tarefas             Tarefa[]
  medicacoes          Medicacao[]
  registosMedicacao   RegistoMedicacao[]
  notasTurno          NotaTurno[]
  passagensTurno      PassagemTurno[]
  sinaisVitais        SinalVital[]
  alergias            Alergia[]
  contactosEmergencia ContactoEmergencia[]
  alertasClinicos     AlertaClinico[]
  avaliacoesRisco     AvaliacaoRisco[]
  sumarioAlta         SumarioAlta?
  // Novos — Fase 7
  notasClincias       NotaClinica[]
  escalasClinicas     EscalaClinica[]
  // Novos — Fase 5
  exames              Exame[]
  episodiosUrgencia   EpisodioUrgencia[]
  cirurgias           CirurgiaProgramada[]
  consultas           Consulta[]
  planosReabilitacao  PlanoReabilitacao[]
  sessoesFisioterapia SessaoFisioterapia[]
  sessoesEspecialidade SessaoEspecialidade[]
  pedidosInternos     PedidoInterno[]
  // Novos — Fase 8A
  interconsultas      Interconsulta[]
  dispositivosInvasivos DispositivoInvasivo[]
  // Dados administrativos (acesso restrito a role 'administrativo')
  ficheiroPessoal     FicheiroPessoalDoente?
  episodiosFaturacao  EpisodioFaturacao[]
  problemas           ProblemaClinico[]
  eventosAdversos     EventoAdverso[]        @relation("EventosAdversosDoente")
  consentimentos      ConsentimentoInformado[]
  breakGlassAcessos   BreakGlassAccess[]
  protocolosClinicos  ProtocoloClinico[]
  prescricoesDieta    PrescricaoDieta[]
  culturasMicrobiologicas    CulturaMicrobiologica[]

  @@index([ativo])
  @@index([estado])
  @@index([dataAdmissao])
  @@index([deletedAt])
  @@map("doentes")
}

// ─── Turnos e Horários ────────────────────────────────────────────────────────

enum TipoTurno {
  manha
  tarde
  noite
}

model Turno {
  id         String    @id @default(uuid())
  tipo       TipoTurno
  dataInicio DateTime
  dataFim    DateTime

  chefeTurnoId String
  chefeTurno   Utilizador @relation("ChefeTurno", fields: [chefeTurnoId], references: [id], onDelete: Restrict)

  atribuicoes            AtribuicaoDoente[]
  horariosEntrada        HorarioEntrada[]
  notasTurno             NotaTurno[]
  tarefas                Tarefa[]
  passagensTurnoAnterior PassagemTurno[] @relation("PassagemTurnoAnterior")
  passagensTurnoAtual    PassagemTurno[] @relation("PassagemTurnoAtual")

  @@index([chefeTurnoId])
  @@index([dataInicio])
  @@index([dataInicio, dataFim, tipo])
  @@map("turnos")
}

model AtribuicaoDoente {
  id           String @id @default(uuid())
  doenteId     String
  enfermeiroId String
  turnoId      String

  doente     Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  enfermeiro Utilizador @relation(fields: [enfermeiroId], references: [id], onDelete: Cascade)
  turno      Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)

  @@unique([doenteId, enfermeiroId, turnoId])
  @@map("atribuicoes_doente")
}

model HorarioEntrada {
  id                 String   @id @default(uuid())
  turnoId            String
  utilizadorId       String
  checkInEm          DateTime @default(now())
  passagemTurnoVista Boolean  @default(false)

  turno      Turno      @relation(fields: [turnoId], references: [id], onDelete: Cascade)
  utilizador Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@unique([turnoId, utilizadorId])
  @@map("horarios_entrada")
}

model PassagemTurno {
  id              String @id @default(uuid())
  turnoAnteriorId String
  turnoAtualId    String
  doenteId        String

  // Desafio de presença em tempo real
  estadoDesafio      String    @default("pendente") // pendente | aceite | expirado
  desafioEnviadoEm   DateTime?
  desafioAceitoEm    DateTime?
  desafioExpiradoEm  DateTime?

  turnoAnterior Turno  @relation("PassagemTurnoAnterior", fields: [turnoAnteriorId], references: [id], onDelete: Cascade)
  turnoAtual    Turno  @relation("PassagemTurnoAtual", fields: [turnoAtualId], references: [id], onDelete: Cascade)
  doente        Doente @relation(fields: [doenteId], references: [id], onDelete: Cascade)

  @@index([estadoDesafio])
  @@map("passagens_turno")
}

model PresencaOnline {
  id           String   @id @default(uuid())
  utilizadorId String   @unique
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  socketId     String
  ligadoEm     DateTime @default(now())
  ultimoPing   DateTime @default(now())

  @@map("presenca_online")
}

model RegistoCheckin {
  id                String   @id @default(uuid())
  utilizadorId      String
  utilizador        Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  turnoId           String?
  lat               Float?
  lon               Float?
  distanciaHospital Float?
  dentroGeofence    Boolean  @default(true)
  ip                String?
  criadoEm          DateTime @default(now())

  @@index([utilizadorId, criadoEm])
  @@map("registos_checkin")
}

// ─── Notas Clínicas SOAP ─────────────────────────────────────────────────────

model NotaClinica {
  id        String     @id @default(uuid())
  doenteId  String
  doente    Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  autorId   String
  autor     Utilizador @relation(fields: [autorId], references: [id], onDelete: Cascade)
  subjetivo String
  objetivo  String
  avaliacao String
  plano     String
  criadaEm      DateTime   @default(now())
  editadaEm     DateTime?
  deletedAt     DateTime?
  assinadaEm    DateTime?
  assinadaPorId String?
  assinadaPor   Utilizador? @relation("NotaAssinatura", fields: [assinadaPorId], references: [id], onDelete: SetNull)

  @@index([doenteId, criadaEm])
  @@index([deletedAt])
  @@index([doenteId, deletedAt])
  @@map("notas_clinicas")
}

// ─── Escalas Clínicas Especializadas ─────────────────────────────────────────

enum TipoEscalaClinica {
  RASS
  CPOT
  SOFA
  CTG
  Apgar
  PEWS
  FLACC
  Barthel
  FIM
  MRC
  FOIS
  NRS2002
  PHQ9
  GAD7
}

model EscalaClinica {
  id             String            @id @default(uuid())
  doenteId       String
  doente         Doente            @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  registadoPorId String
  registadoPor   Utilizador        @relation(fields: [registadoPorId], references: [id], onDelete: Cascade)
  tipo           TipoEscalaClinica
  valores        Json
  pontuacao      Int?
  classificacao  String?
  observacoes    String?
  registadaEm    DateTime          @default(now())

  @@index([doenteId, tipo])
  @@map("escalas_clinicas")
}

// ─── Notas de Turno ──────────────────────────────────────────────────────────

model NotaTurno {
  id       String   @id @default(uuid())
  texto    String
  criadaEm DateTime @default(now())

  turnoId  String?
  doenteId String
  autorId  String

  turno  Turno?     @relation(fields: [turnoId], references: [id], onDelete: SetNull)
  doente Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  autor  Utilizador @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@map("notas_turno")
}

// ─── Tarefas ─────────────────────────────────────────────────────────────────

enum TipoTarefa {
  clinica
  logistica
}

enum PrioridadeTarefa {
  baixa
  media
  alta
  urgente
}

enum EstadoTarefa {
  pendente
  em_progresso
  concluida
  cancelada
}

model Tarefa {
  id               String           @id @default(uuid())
  descricao        String
  tipo             TipoTarefa
  prioridade       PrioridadeTarefa @default(media)
  estado           EstadoTarefa     @default(pendente)
  prazo            DateTime?
  transitouDeTurno Boolean          @default(false)
  criadaEm         DateTime         @default(now())
  concluidaEm      DateTime?

  doenteId         String
  responsavelId    String?
  grupoResponsavel String?
  criadoPorId      String
  turnoId          String?

  doente      Doente      @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  responsavel Utilizador? @relation("TarefaResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoPor   Utilizador  @relation("TarefaCriadaPor", fields: [criadoPorId], references: [id], onDelete: Cascade)
  turno       Turno?      @relation(fields: [turnoId], references: [id], onDelete: SetNull)

  @@index([doenteId, estado])
  @@index([responsavelId, estado])
  @@map("tarefas")
}

// ─── Medicação ───────────────────────────────────────────────────────────────

model Medicacao {
  id          String    @id @default(uuid())
  nome        String
  dose        String
  via         String
  frequencia  String
  ativo       Boolean   @default(true)
  iniciadoEm  DateTime  @default(now())
  terminadoEm DateTime?
  deletedAt   DateTime?

  doenteId       String
  prescritoPorId String

  estadoValidacao String?   // pendente | aprovada | rejeitada
  validadoPorId   String?
  validadaEm      DateTime?
  motivoRejeicao  String?
  assinadoEm      DateTime?
  assinadoPorId   String?

  doente       Doente      @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  prescritoPor Utilizador  @relation("MedicacaoPrescritor", fields: [prescritoPorId], references: [id], onDelete: Cascade)
  validadoPor  Utilizador? @relation("MedicacaoValidador", fields: [validadoPorId], references: [id], onDelete: SetNull)
  assinadoPor  Utilizador? @relation("MedicacaoAssinatura", fields: [assinadoPorId], references: [id], onDelete: SetNull)
  registos     RegistoMedicacao[]

  @@index([doenteId, ativo])
  @@index([doenteId, ativo, iniciadoEm])
  @@index([estadoValidacao])
  @@index([deletedAt])
  @@index([doenteId, deletedAt])
  @@map("medicacoes")
}

model RegistoMedicacao {
  id             String   @id @default(uuid())
  administradoEm     DateTime @default(now())
  observacoes        String?
  verificacao5Certas Boolean  @default(false)
  naoAdministrada    Boolean  @default(false)
  motivoNaoAdmin     String?
  deletedAt          DateTime?

  medicacaoId       String
  doenteId          String
  administradoPorId String

  medicacao       Medicacao  @relation(fields: [medicacaoId], references: [id], onDelete: Cascade)
  doente          Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  administradoPor Utilizador @relation(fields: [administradoPorId], references: [id], onDelete: Cascade)

  @@index([medicacaoId])
  @@index([doenteId, administradoEm])
  @@index([deletedAt])
  @@index([doenteId, deletedAt])
  @@map("registos_medicacao")
}

// ─── Escalas ─────────────────────────────────────────────────────────────────

model Escala {
  id          String   @id @default(uuid())
  mes         Int
  ano         Int
  criadaEm   DateTime @default(now())
  criadaPorId String

  criadaPor Utilizador     @relation(fields: [criadaPorId], references: [id], onDelete: Cascade)
  turnos    HorarioTurno[]

  @@unique([mes, ano])
  @@map("escalas")
}

model HorarioTurno {
  id      String    @id @default(uuid())
  tipo    TipoTurno
  data    DateTime
  escalId String

  escala        Escala                   @relation(fields: [escalId], references: [id], onDelete: Cascade)
  profissionais HorarioTurnoProfissional[]
  atribuicoes   AtribuicaoHorarioTurno[]
  trocas        PedidoTrocaTurno[]       @relation("TrocaTurno")

  @@map("horarios_turno")
}

model HorarioTurnoProfissional {
  horarioTurnoId String
  utilizadorId   String

  horarioTurno HorarioTurno @relation(fields: [horarioTurnoId], references: [id], onDelete: Cascade)
  utilizador   Utilizador   @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@id([horarioTurnoId, utilizadorId])
  @@map("horarios_turno_profissionais")
}

enum EstadoPedidoTroca {
  pendente_destinatario
  pendente_chefe
  aprovado
  rejeitado
}

model PedidoTrocaTurno {
  id           String            @id @default(uuid())
  estado       EstadoPedidoTroca @default(pendente_destinatario)
  criadoEm     DateTime          @default(now())
  respondidoEm DateTime?

  solicitanteId  String
  turnoId        String
  destinatarioId String
  aprovadoPorId  String?

  solicitante  Utilizador   @relation("TrocaSolicitante", fields: [solicitanteId], references: [id], onDelete: Cascade)
  destinatario Utilizador   @relation("TrocaDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  turno        HorarioTurno @relation("TrocaTurno", fields: [turnoId], references: [id], onDelete: Cascade)
  aprovadoPor  Utilizador?  @relation("TrocaAprovadoPor", fields: [aprovadoPorId], references: [id], onDelete: SetNull)

  @@map("pedidos_troca_turno")
}

model AtribuicaoHorarioTurno {
  id             String @id @default(uuid())
  horarioTurnoId String
  doenteId       String
  utilizadorId   String
  atribuidoPorId String

  horarioTurno HorarioTurno @relation(fields: [horarioTurnoId], references: [id], onDelete: Cascade)
  doente       Doente       @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  utilizador   Utilizador   @relation("AtribuicaoUtilizador", fields: [utilizadorId], references: [id], onDelete: Cascade)
  atribuidoPor Utilizador   @relation("AtribuicaoAtribuidoPor", fields: [atribuidoPorId], references: [id], onDelete: Cascade)

  @@unique([horarioTurnoId, doenteId, utilizadorId])
  @@index([utilizadorId, horarioTurnoId])
  @@map("atribuicoes_horario_turno")
}

// ─── Sinais Vitais ────────────────────────────────────────────────────────────

model SinalVital {
  id                    String     @id @default(uuid())
  doenteId              String
  doente                Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  registadoPorId        String
  registadoPor          Utilizador @relation("SinaisVitaisRegistados", fields: [registadoPorId], references: [id], onDelete: Cascade)
  data                  DateTime   @default(now())

  pressaoSistolica      Int?
  pressaoDiastolica     Int?
  pulso                 Int?
  temperatura           Float?
  saturacaoO2           Int?
  frequenciaRespiratoria Int?
  peso                  Float?
  notas                 String?
  avpu                  String?    // A=Alert V=Voice P=Pain U=Unresponsive (NEWS2)
  news2                 Int?       // score NEWS2 calculado automaticamente

  @@index([doenteId, data])
  @@map("sinais_vitais")
}

// ─── Audit Log ───────────────────────────────────────────────────────────────

model AuditLog {
  id           String     @id @default(uuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Restrict)
  acao         String
  entidadeId   String?
  entidadeTipo String?
  detalhes     String?
  ip           String?
  userAgent    String?
  createdAt    DateTime   @default(now())

  @@index([utilizadorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── Alergias ─────────────────────────────────────────────────────────────────

model Alergia {
  id         String   @id @default(uuid())
  doenteId   String
  doente     Doente   @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  alergenio  String
  tipo       String
  severidade String
  notas      String?
  criadaEm   DateTime @default(now())

  @@index([doenteId])
  @@map("alergias")
}

// ─── Contactos de Emergência ──────────────────────────────────────────────────

model ContactoEmergencia {
  id        String  @id @default(uuid())
  doenteId  String
  doente    Doente  @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  nome      String
  relacao   String
  telefone  String
  principal Boolean @default(false)

  @@map("contactos_emergencia")
}

// ─── Alertas Clínicos ─────────────────────────────────────────────────────────

model AlertaClinico {
  id       String   @id @default(uuid())
  doenteId String
  doente   Doente   @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo     String
  mensagem String
  lido     Boolean  @default(false)
  urgencia     Boolean   @default(false)
  acusadoPorId String?
  acusadoPor   Utilizador? @relation("AlertaAcusador", fields: [acusadoPorId], references: [id], onDelete: SetNull)
  acusadoEm    DateTime?
  escaladoEm   DateTime?
  criadoEm DateTime @default(now())

  @@index([doenteId, lido])
  @@index([doenteId, lido, criadoEm])
  @@index([criadoEm])
  @@map("alertas_clinicos")
}

// ─── Avaliações de Risco Clínico ─────────────────────────────────────────────

model AvaliacaoRisco {
  id             String     @id @default(uuid())
  doenteId       String
  doente         Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo           String
  pontuacao      Int
  itens          Json
  risco          String
  registadoPorId String
  registadoPor   Utilizador @relation(fields: [registadoPorId], references: [id], onDelete: Cascade)
  criadaEm       DateTime   @default(now())

  @@map("avaliacoes_risco")
}

// ─── Sumário de Alta ──────────────────────────────────────────────────────────

model SumarioAlta {
  id             String     @id @default(uuid())
  doenteId       String     @unique
  doente         Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  motivoAlta     String
  destino        String?
  resumoClinical String
  prescricaoSaida String?
  medicoFamilia  String?
  criadoPorId    String
  criadoPor      Utilizador @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoEm       DateTime   @default(now())

  @@map("sumarios_alta")
}

// ─── Dispositivos / Push Tokens ───────────────────────────────────────────────

model DispositivoToken {
  id           String     @id @default(uuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  token        String     @unique
  plataforma   String
  criadoEm    DateTime   @default(now())

  @@map("dispositivos_tokens")
}

// ─── Notificações In-App ──────────────────────────────────────────────────────

model NotificacaoInApp {
  id           String     @id @default(uuid())
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  titulo       String
  corpo        String
  lida         Boolean    @default(false)
  dadosExtra   Json?
  criadaEm     DateTime   @default(now())
  lidaEm       DateTime?

  @@index([utilizadorId, lida])
  @@index([utilizadorId, lida, criadaEm])
  @@index([criadaEm])
  @@map("notificacoes_inapp")
}

// ═══════════════════════════════════════════════════════════════════════════════
// FASE 5 — EXPANSÃO HOSPITALAR
// ═══════════════════════════════════════════════════════════════════════════════

// ─── Exames Complementares de Diagnóstico ────────────────────────────────────

enum TipoExame {
  analise_clinica
  rx
  eco
  tc
  rmn
  ecg
  outro
}

enum EstadoExame {
  solicitado
  em_progresso
  resultado_disponivel
  cancelado
}

model Exame {
  id              String      @id @default(uuid())
  doenteId        String
  doente          Doente      @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  solicitadoPorId String
  solicitadoPor   Utilizador  @relation("ExameSolicitadoPor", fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  tipo            TipoExame
  descricao       String
  urgente         Boolean     @default(false)
  estado          EstadoExame @default(solicitado)
  resultado       String?
  dataResultado   DateTime?
  observacoes     String?
  criadoEm        DateTime    @default(now())

  ficheiros FicheiroExame[]

  @@index([estado, urgente])
  @@index([doenteId, estado])
  @@map("exames")
}

model FicheiroExame {
  id       String @id @default(uuid())
  exameId  String
  exame    Exame  @relation(fields: [exameId], references: [id], onDelete: Cascade)
  nome     String
  url      String
  mimeType String

  @@map("ficheiros_exame")
}

// ─── Urgência / Triagem ───────────────────────────────────────────────────────

enum CorTriagem {
  vermelho
  laranja
  amarelo
  verde
  azul
}

enum EstadoEpisodio {
  triagem
  sala_espera
  em_atendimento
  alta_urgencia
  internado
  transferido
}

model EpisodioUrgencia {
  id                String         @id @default(uuid())
  doenteId          String?
  doente            Doente?        @relation(fields: [doenteId], references: [id], onDelete: SetNull)
  nomeTemporario    String?
  queixaPrincipal   String
  triagem           CorTriagem
  estadoEpisodio    EstadoEpisodio @default(sala_espera)
  triadoPorId       String
  triadoPor         Utilizador     @relation("EpisodioTriador", fields: [triadoPorId], references: [id], onDelete: Cascade)
  medicoResponsavelId String?
  medicoResponsavel Utilizador?    @relation("EpisodioMedico", fields: [medicoResponsavelId], references: [id], onDelete: SetNull)
  dataEntrada       DateTime       @default(now())
  dataSaida         DateTime?
  notas             String?
  sinaisVitaisTriagem Json?
  preNotificacao    Boolean        @default(false)
  etaMinutos        Int?
  condicaoPrevia    String?

  @@index([estadoEpisodio, dataEntrada])
  @@map("episodios_urgencia")
}

// ─── Bloco Operatório ────────────────────────────────────────────────────────

enum EstadoCirurgia {
  agendada
  em_curso
  concluida
  cancelada
  adiada
}

model CirurgiaProgramada {
  id                 String         @id @default(uuid())
  doenteId           String
  doente             Doente         @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  designacao         String
  dataHora           DateTime
  duracaoPrevista    Int
  sala               String
  estado             EstadoCirurgia @default(agendada)
  cirurgiaoId        String
  cirurgiao          Utilizador     @relation("CirurgiaCircurgiao", fields: [cirurgiaoId], references: [id], onDelete: Cascade)
  anestesistaId      String?
  anestesista        Utilizador?    @relation("CirurgiaAnestesista", fields: [anestesistaId], references: [id], onDelete: SetNull)
  equipa             Json?
  notasPreOperatorio  String?
  notasPosOperatorio  String?
  complicacoes       String?
  criadoEm           DateTime       @default(now())
  checklist          ChecklistCirurgia?

  @@index([dataHora])
  @@index([estado])
  @@map("cirurgias_programadas")
}

model ChecklistCirurgia {
  id         String             @id @default(uuid())
  cirurgiaId String             @unique
  cirurgia   CirurgiaProgramada @relation(fields: [cirurgiaId], references: [id], onDelete: Cascade)

  signInEm    DateTime?
  signInPorId String?
  signInPor   Utilizador? @relation("ChecklistSignIn", fields: [signInPorId], references: [id], onDelete: SetNull)
  signInDados Json?

  timeOutEm    DateTime?
  timeOutPorId String?
  timeOutPor   Utilizador? @relation("ChecklistTimeOut", fields: [timeOutPorId], references: [id], onDelete: SetNull)
  timeOutDados Json?

  signOutEm    DateTime?
  signOutPorId String?
  signOutPor   Utilizador? @relation("ChecklistSignOut", fields: [signOutPorId], references: [id], onDelete: SetNull)
  signOutDados Json?

  @@map("checklists_cirurgia")
}

// ─── Consultas Externas ───────────────────────────────────────────────────────

enum EstadoConsulta {
  agendada
  realizada
  faltou
  cancelada
}

model Consulta {
  id                 String               @id @default(uuid())
  doenteId           String?
  doente             Doente?              @relation(fields: [doenteId], references: [id], onDelete: SetNull)
  nomeDoente         String?
  medicoId           String
  medico             Utilizador           @relation(fields: [medicoId], references: [id], onDelete: Cascade)
  especialidade      String
  dataHora           DateTime
  duracao            Int                  @default(30)
  estado             EstadoConsulta       @default(agendada)
  notas              String?
  diagnostico        String?
  proximaConsulta    DateTime?
  codigo             String?              @unique
  checkinEm          DateTime?
  criadoEm           DateTime             @default(now())
  atosConsulta       AtoConsulta[]
  episodioFaturacao  EpisodioFaturacao?

  @@index([medicoId, dataHora])
  @@index([codigo])
  @@map("consultas")
}

model AgendaMedico {
  id          String     @id @default(uuid())
  medicoId    String
  medico      Utilizador @relation("AgendaMedico", fields: [medicoId], references: [id], onDelete: Cascade)
  diaSemana   Int        // 0=Dom 1=Seg 2=Ter 3=Qua 4=Qui 5=Sex 6=Sab
  horaInicio  String     // "08:00"
  horaFim     String     // "13:00"
  duracaoSlot Int        @default(20)
  ativo       Boolean    @default(true)
  criadoEm   DateTime   @default(now())

  @@unique([medicoId, diaSemana])
  @@map("agenda_medico")
}

// ─── Sala de Espera ───────────────────────────────────────────────────────────

enum EstadoCheckin {
  aguardando
  em_atendimento
  atendido
  desistiu
  ausente
}

model CheckinSalaEspera {
  id              String         @id @default(uuid())
  nomeDoente      String
  dataNascimento  DateTime?
  numeroUtente    String?
  motivo          String
  prioridade      Int            @default(3)
  estado          EstadoCheckin  @default(aguardando)
  chegadaEm       DateTime       @default(now())
  chamadoEm       DateTime?
  atendidoEm      DateTime?
  rececionistadoPorId String?
  rececionista    Utilizador?    @relation("CheckinRececionista", fields: [rececionistadoPorId], references: [id], onDelete: SetNull)
  medicoId        String?
  medico          Utilizador?    @relation("CheckinMedico", fields: [medicoId], references: [id], onDelete: SetNull)
  observacoes     String?

  @@index([estado, chegadaEm])
  @@map("checkins_sala_espera")
}

// ─── Farmácia / Stock ─────────────────────────────────────────────────────────

enum TipoStock {
  medicamento
  material
  consumivel
}

enum EstadoPedidoFarmacia {
  pendente
  aprovado
  rejeitado
  dispensado
  cancelado
}

model StockItem {
  id               String    @id @default(uuid())
  nome             String
  tipo             TipoStock
  quantidade       Float     @default(0)
  quantidadeMinima Float     @default(0)
  unidade          String
  validade         DateTime?
  servico          String
  precoUnitario    Float?
  catalogoId       String?
  catalogo         CatalogoMedicamento? @relation(fields: [catalogoId], references: [id], onDelete: SetNull)
  criadoEm         DateTime  @default(now())

  pedidos       PedidoFarmacia[]
  ajustes       AjusteStock[]
  transferencias TransferenciaStock[]
  encomendas    EncomendaFornecedor[]

  @@index([catalogoId])
  @@index([servico])
  @@map("stock_items")
}

model PedidoFarmacia {
  id              String               @id @default(uuid())
  stockItemId     String
  stockItem       StockItem            @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantidade      Float
  servico         String
  estado          EstadoPedidoFarmacia @default(pendente)
  solicitadoPorId String
  solicitadoPor   Utilizador           @relation("PedidoSolicitante", fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  processadoPorId String?
  processadoPor   Utilizador?          @relation("PedidoProcessador", fields: [processadoPorId], references: [id], onDelete: SetNull)
  aprovadoPorId   String?
  aprovadoPor     Utilizador?          @relation("PedidoAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  aprovadoEm      DateTime?
  motivoRejeicao  String?
  observacoes     String?
  criadoEm        DateTime             @default(now())

  @@index([estado, criadoEm])
  @@map("pedidos_farmacia")
}

model CatalogoMedicamento {
  id                String      @id @default(uuid())
  dci               String
  nomeMarca         String?
  formaFarmaceutica String
  classeTerap       String
  unidade           String
  concentracao      String?
  codigoATC         String?
  ativo             Boolean     @default(true)
  criadoEm          DateTime    @default(now())

  stockItems StockItem[]

  @@map("catalogo_medicamentos")
}

model AjusteStock {
  id           String    @id @default(uuid())
  stockItemId  String
  stockItem    StockItem @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  delta        Float
  tipo         String    // "entrada" | "saida" | "ajuste" | "desperdicio" | "validade" | "encomenda" | "transferencia"
  motivo       String
  utilizadorId String
  utilizador   Utilizador @relation("AjustesFeitos", fields: [utilizadorId], references: [id], onDelete: Cascade)
  criadoEm     DateTime  @default(now())

  @@index([stockItemId])
  @@index([criadoEm])
  @@map("ajustes_stock")
}

model TransferenciaStock {
  id              String      @id @default(uuid())
  stockItemId     String
  stockItem       StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantidade      Float
  servicoOrigem   String
  servicoDestino  String
  motivo          String?
  estado          String      @default("pendente") // pendente | confirmada | cancelada
  solicitadoPorId String
  solicitadoPor   Utilizador  @relation("TransfSolicitadas", fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  confirmadoPorId String?
  confirmadoPor   Utilizador? @relation("TransfConfirmadas", fields: [confirmadoPorId], references: [id], onDelete: SetNull)
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  @@index([stockItemId])
  @@map("transferencias_stock")
}

model Fornecedor {
  id        String   @id @default(uuid())
  nome      String
  nif       String?  @unique
  email     String?
  telefone  String?
  morada    String?
  ativo     Boolean  @default(true)
  criadoEm DateTime @default(now())

  encomendas EncomendaFornecedor[]

  @@map("fornecedores")
}

model EncomendaFornecedor {
  id                    String      @id @default(uuid())
  fornecedorId          String
  fornecedor            Fornecedor  @relation(fields: [fornecedorId], references: [id], onDelete: Cascade)
  stockItemId           String
  stockItem             StockItem   @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  quantidadeEncomendada Float
  precoUnitario         Float?
  estado                String      @default("pendente") // pendente | recebida | parcial | cancelada
  dataEntregaPrevista   DateTime?
  dataEntregaReal       DateTime?
  observacoes           String?
  recebioPorId          String?
  recebioPor            Utilizador? @relation("EncomendasRecebidas", fields: [recebioPorId], references: [id], onDelete: SetNull)
  criadoEm              DateTime    @default(now())
  atualizadoEm          DateTime    @updatedAt

  @@index([fornecedorId])
  @@index([stockItemId])
  @@map("encomendas_fornecedor")
}

// ─── Fisioterapia / Reabilitação ──────────────────────────────────────────────

model PlanoReabilitacao {
  id               String   @id @default(uuid())
  doenteId         String
  doente           Doente   @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  fisioterapeutaId String
  fisioterapeuta   Utilizador @relation(fields: [fisioterapeutaId], references: [id], onDelete: Cascade)
  objetivos        String
  dataInicio       DateTime
  dataFimPrevista  DateTime?
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now())

  sessoes SessaoFisioterapia[]

  @@map("planos_reabilitacao")
}

enum EstadoSessao {
  agendada
  realizada
  cancelada
  faltou
}

model SessaoFisioterapia {
  id               String       @id @default(uuid())
  planoId          String
  plano            PlanoReabilitacao @relation(fields: [planoId], references: [id], onDelete: Cascade)
  doenteId         String
  doente           Doente       @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  fisioterapeutaId String
  fisioterapeuta   Utilizador   @relation(fields: [fisioterapeutaId], references: [id], onDelete: Cascade)
  data             DateTime
  duracao          Int
  descricao        String
  evolucao         String?
  estado           EstadoSessao @default(agendada)

  @@map("sessoes_fisioterapia")
}

// ─── Pedidos Internos ────────────────────────────────────────────────────────

enum TipoPedidoInterno {
  transporte
  esterilizacao
  equipamento
  limpeza
}

enum EstadoPedidoInterno {
  pendente
  em_curso
  concluido
  cancelado
}

model PedidoInterno {
  id              String              @id @default(uuid())
  tipo            TipoPedidoInterno
  doenteId        String?
  doente          Doente?             @relation(fields: [doenteId], references: [id], onDelete: SetNull)
  localOrigem     String?
  localDestino    String?
  descricao       String
  prioridade      PrioridadeTarefa
  estado          EstadoPedidoInterno @default(pendente)
  solicitadoPorId String
  solicitadoPor   Utilizador          @relation("PedidoInternoSolicitante", fields: [solicitadoPorId], references: [id], onDelete: Cascade)
  executadoPorId  String?
  executadoPor    Utilizador?         @relation("PedidoInternoExecutor", fields: [executadoPorId], references: [id], onDelete: SetNull)
  servicoOrigem   String
  criadoEm        DateTime            @default(now())
  concluidoEm     DateTime?

  @@index([estado, criadoEm])
  @@map("pedidos_internos")
}

// ─── Comunicação Interna ──────────────────────────────────────────────────────

model Anuncio {
  id       String    @id @default(uuid())
  autorId  String
  autor    Utilizador @relation(fields: [autorId], references: [id], onDelete: Cascade)
  titulo   String
  texto    String
  servico  String?
  ativo    Boolean   @default(true)
  criadoEm DateTime  @default(now())
  expiraEm DateTime?

  @@map("anuncios")
}

model MensagemInterna {
  id             String          @id @default(uuid())
  remetenteId    String
  remetente      Utilizador      @relation("MensagemRemetente", fields: [remetenteId], references: [id], onDelete: Cascade)
  destinatarioId String
  destinatario   Utilizador      @relation("MensagemDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  assunto        String?
  texto          String
  lida           Boolean         @default(false)
  criadaEm      DateTime        @default(now())
  anexos         AnexoMensagem[]

  @@index([destinatarioId, lida])
  @@index([remetenteId])
  @@map("mensagens_internas")
}

model AnexoMensagem {
  id          String          @id @default(uuid())
  mensagemId  String
  mensagem    MensagemInterna @relation(fields: [mensagemId], references: [id], onDelete: Cascade)
  nome        String
  url         String
  mimeType    String
  tamanho     Int
  criadoEm   DateTime        @default(now())

  @@index([mensagemId])
  @@map("anexos_mensagem")
}

// ─── Interconsultas ──────────────────────────────────────────────────────────

enum EstadoInterconsulta {
  pendente
  aceite
  respondida
  cancelada
}

model Interconsulta {
  id                String               @id @default(uuid())
  doenteId          String
  doente            Doente               @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  requisitanteId    String
  requisitante      Utilizador           @relation("InterconsultaRequisitante", fields: [requisitanteId], references: [id], onDelete: Cascade)
  especialidadeAlvo String
  motivo            String
  urgente           Boolean              @default(false)
  estado            EstadoInterconsulta  @default(pendente)
  medicoRespostaId  String?
  medicoResposta    Utilizador?          @relation("InterconsultaResposta", fields: [medicoRespostaId], references: [id], onDelete: SetNull)
  resposta          String?
  criadaEm          DateTime             @default(now())
  respondidaEm      DateTime?

  @@index([doenteId])
  @@index([especialidadeAlvo, estado])
  @@index([requisitanteId, estado])
  @@map("interconsultas")
}

// ─── Dispositivos Invasivos ──────────────────────────────────────────────────

enum TipoDispositivoInvasivo {
  cateter_venoso_central
  cateter_venoso_periferico
  cateter_arterial
  sonda_vesical
  tubo_orotaqueal
  traqueostomia
  dreno_toracico
  sonda_nasogastrica
  linha_epidural
  outro
}

model DispositivoInvasivo {
  id            String                  @id @default(uuid())
  doenteId      String
  doente        Doente                  @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo          TipoDispositivoInvasivo
  localizacao   String?
  dataInsercao  DateTime                @default(now())
  dataRemocao   DateTime?
  ativo         Boolean                 @default(true)
  observacoes   String?
  inseridoPorId String
  inseridoPor   Utilizador              @relation("DispositivoInserido", fields: [inseridoPorId], references: [id], onDelete: Cascade)

  @@index([doenteId, ativo])
  @@map("dispositivos_invasivos")
}

// ─── Incidentes TI ───────────────────────────────────────────────────────────

enum TipoIncidenteTI {
  infraestrutura
  rede
  his_erp
  base_dados
  seguranca
  dados_clinicos
  outro
}

enum EstadoIncidenteTI {
  aberto
  em_analise
  resolvido
  fechado
}

enum PrioridadeIncidenteTI {
  baixa
  media
  alta
  critica
}

model IncidenteTI {
  id            String                @id @default(uuid())
  titulo        String
  descricao     String
  tipo          TipoIncidenteTI
  subRoleAlvo   String?
  prioridade    PrioridadeIncidenteTI @default(media)
  estado        EstadoIncidenteTI     @default(aberto)
  criadoPorId   String
  criadoPor     Utilizador            @relation("IncidentesCriados", fields: [criadoPorId], references: [id], onDelete: Cascade)
  responsavelId String?
  responsavel   Utilizador?           @relation("IncidentesAtribuidos", fields: [responsavelId], references: [id], onDelete: SetNull)
  criadoEm     DateTime              @default(now())
  atualizadoEm DateTime              @updatedAt
  notas         NotaIncidenteTI[]

  @@index([estado])
  @@index([subRoleAlvo])
  @@map("incidentes_ti")
}

model NotaIncidenteTI {
  id           String       @id @default(uuid())
  incidenteId  String
  incidente    IncidenteTI  @relation(fields: [incidenteId], references: [id], onDelete: Cascade)
  autorId      String
  autor        Utilizador   @relation("NotasIncidentesTI", fields: [autorId], references: [id], onDelete: Cascade)
  conteudo     String
  criadaEm    DateTime     @default(now())

  @@index([incidenteId])
  @@map("notas_incidentes_ti")
}

// ─── Pedidos TI ───────────────────────────────────────────────────────────────

enum TipoPedidoTI {
  listagem_dados
  relatorio
  acesso_sistema
  backup
  auditoria_dados
  outro
}

enum EstadoPedidoTI {
  pendente
  em_curso
  concluido
  recusado
}

model PedidoTI {
  id            String         @id @default(cuid())
  titulo        String
  descricao     String
  tipo          TipoPedidoTI
  estado        EstadoPedidoTI @default(pendente)
  urgente       Boolean        @default(false)
  criadoEm      DateTime       @default(now())
  resolvidoEm   DateTime?

  criadoPorId   String
  criadoPor     Utilizador  @relation("PedidosTICriados", fields: [criadoPorId], references: [id], onDelete: Cascade)

  responsavelId String?
  responsavel   Utilizador? @relation("PedidosTIAtribuidos", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([criadoPorId])
  @@map("pedidos_ti")
}

// ─── Ficha Pessoal do Doente (acesso restrito: só role 'administrativo') ──────

model FicheiroPessoalDoente {
  id                 String      @id @default(uuid())
  doenteId           String      @unique
  doente             Doente      @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  nif                String?
  numeroSNS          String?
  morada             String?
  codigoPostal       String?
  localidade         String?
  telefone           String?
  email              String?
  entidadeSeguradora String?
  numeroApolice      String?
  tipoCobertura      String?     // 'sns' | 'seguro' | 'particular'
  atualizadoEm       DateTime    @updatedAt
  atualizadoPorId    String?
  atualizadoPor      Utilizador? @relation(fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("fichas_pessoais_doente")
}

// ─── Faturação ────────────────────────────────────────────────────────────────

enum EstadoFatura {
  pendente
  emitida
  paga
  isenta
  anulada
}

model EpisodioFaturacao {
  id            String         @id @default(uuid())
  doenteId      String
  doente        Doente         @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  consultaId    String?        @unique
  consulta      Consulta?      @relation(fields: [consultaId], references: [id], onDelete: SetNull)
  estado        EstadoFatura   @default(pendente)
  dataEmissao   DateTime?
  totalBase     Float          @default(0)
  totalCobrado  Float          @default(0)
  tipoCobertura String?
  notas         String?
  criadoPorId   String
  criadoPor     Utilizador     @relation(fields: [criadoPorId], references: [id], onDelete: Cascade)
  criadoEm      DateTime       @default(now())
  itens         ItemFatura[]
  pagamentos    Pagamento[]

  @@index([doenteId])
  @@index([estado])
  @@map("episodios_faturacao")
}

model ItemFatura {
  id                  String            @id @default(uuid())
  episodioFaturacaoId String
  episodio            EpisodioFaturacao @relation(fields: [episodioFaturacaoId], references: [id], onDelete: Cascade)
  descricao           String
  categoria           String            // 'diaria' | 'procedimento' | 'medicacao' | 'exame' | 'outro'
  quantidade          Int               @default(1)
  precoUnitario       Float
  total               Float
  criadoEm            DateTime          @default(now())

  @@map("itens_fatura")
}

model Pagamento {
  id                  String            @id @default(uuid())
  episodioFaturacaoId String
  episodio            EpisodioFaturacao @relation(fields: [episodioFaturacaoId], references: [id], onDelete: Cascade)
  valor               Float
  metodo              String            // 'numerario' | 'multibanco' | 'transferencia' | 'seguro' | 'isencao'
  referencia          String?
  registadoPorId      String
  registadoPor        Utilizador        @relation(fields: [registadoPorId], references: [id], onDelete: Cascade)
  criadoEm            DateTime          @default(now())

  @@map("pagamentos")
}

// ─── Catálogo de Atos Clínicos ───────────────────────────────────────────────

model AtoClinico {
  id            String        @id @default(uuid())
  codigo        String        @unique
  descricao     String
  categoria     String        // 'consulta' | 'exame' | 'procedimento' | 'medicacao' | 'outro'
  precoBase     Float
  especialidade String?       // se definido, é o ato-base automático desta especialidade
  ativo         Boolean       @default(true)
  criadoEm      DateTime      @default(now())
  atosConsulta  AtoConsulta[]

  @@map("atos_clinicos")
}

model AtoConsulta {
  id            String     @id @default(uuid())
  consultaId    String
  consulta      Consulta   @relation(fields: [consultaId], references: [id], onDelete: Cascade)
  atoId         String
  ato           AtoClinico @relation(fields: [atoId], references: [id], onDelete: Cascade)
  quantidade    Int        @default(1)
  precoUnitario Float
  criadoEm      DateTime   @default(now())

  @@map("atos_consulta")
}

// ─── Tickets / Filas de Espera ───────────────────────────────────────────────

model Ticket {
  id          String    @id @default(uuid())
  numero      String    // ex: 'A045', 'C012'
  letra       String    // 'A' | 'C' | 'F' | 'R' | 'E' | 'U' | 'G'
  sequencia   Int
  tipo        String    // admissao | consulta | faturacao | farmacia | exames | urgencia | geral
  estado      String    @default("aguarda")  // aguarda | chamado | em_atendimento | concluido | desistiu
  prioridade  String    @default("normal")   // normal | prioritario | senior
  balcao      String?
  nomeUtente  String?
  telefone    String?
  criadoEm   DateTime  @default(now())
  chamadoEm  DateTime?
  concluidoEm DateTime?

  @@index([estado, criadoEm])
  @@index([tipo, criadoEm])
  @@map("tickets")
}

// ─── Refresh Tokens ──────────────────────────────────────────────────────────

model RefreshToken {
  id           String     @id @default(uuid())
  token        String     @unique
  utilizadorId String
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  revogado     Boolean    @default(false)
  criadoEm    DateTime   @default(now())

  @@index([utilizadorId])
  @@index([token])
  @@map("refresh_tokens")
}

// ─── Problemas Clínicos ──────────────────────────────────────────────────────

model ProblemaClinico {
  id             String     @id @default(uuid())
  doenteId       String
  doente         Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  descricao      String
  tipo           String     // 'principal' | 'comorbilidade' | 'cirurgico' | 'cronico' | 'agudo'
  estado         String     @default("ativo") // 'ativo' | 'resolvido' | 'cronico'
  dataInicio     DateTime?
  dataFim        DateTime?
  registadoPorId String
  registadoPor   Utilizador @relation("ProblemaRegistado", fields: [registadoPorId], references: [id], onDelete: Cascade)
  criadoEm       DateTime   @default(now())

  @@index([doenteId])
  @@map("problemas_clinicos")
}

// ─── Equipamentos e Manutenção ───────────────────────────────────────────────

model Equipamento {
  id                String       @id @default(uuid())
  nome              String
  tipo              String       // 'cama_eletrica'|'ventilador'|'monitor'|'cadeira_rodas'|'bomba_perfusao'|'desfibrilhador'|'outro'
  numeroSerie       String?
  localizacao       String?
  estado            String       @default("operacional") // 'operacional'|'em_manutencao'|'avariado'|'abatido'
  ultimaManutencao  DateTime?
  proximaManutencao DateTime?
  criadoEm          DateTime     @default(now())
  manutencoes       Manutencao[]

  @@index([estado])
  @@map("equipamentos")
}

model Manutencao {
  id              String      @id @default(uuid())
  equipamentoId   String
  equipamento     Equipamento @relation(fields: [equipamentoId], references: [id], onDelete: Cascade)
  tipo            String      // 'preventiva' | 'corretiva'
  descricao       String
  estado          String      @default("pendente") // 'pendente'|'em_curso'|'concluida'|'cancelada'
  prioridade      String      @default("normal")   // 'urgente'|'alta'|'normal'|'baixa'
  reportadoPorId  String?
  reportadoPor    Utilizador? @relation("ManutencaoReportada", fields: [reportadoPorId], references: [id], onDelete: SetNull)
  tecnicoId       String?
  tecnico         Utilizador? @relation("ManutencaoTecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)
  dataReporte     DateTime    @default(now())
  dataConclusao   DateTime?
  observacoes     String?

  @@index([equipamentoId])
  @@index([estado])
  @@map("manutencoes")
}

// ─── RH ──────────────────────────────────────────────────────────────────────

model Ausencia {
  id              String      @id @default(uuid())
  utilizadorId    String
  utilizador      Utilizador  @relation("AusenciaUtilizador", fields: [utilizadorId], references: [id], onDelete: Cascade)
  tipo            String      // 'ferias'|'baixa_medica'|'licenca_maternidade'|'falta_justificada'|'outro'
  dataInicio      DateTime
  dataFim         DateTime
  estado          String      @default("pendente") // 'pendente'|'aprovada'|'rejeitada'
  observacoes     String?
  aprovadoPorId   String?
  aprovadoPor     Utilizador? @relation("AusenciaAprovador", fields: [aprovadoPorId], references: [id], onDelete: SetNull)
  criadoEm        DateTime    @default(now())
  atualizadoEm    DateTime    @updatedAt

  @@index([utilizadorId])
  @@index([estado])
  @@map("ausencias")
}

model TrocaFolga {
  id              String    @id @default(uuid())
  solicitanteId   String
  destinatarioId  String
  dataOrigem      DateTime  // dia do solicitante (folga a ceder)
  dataDestino     DateTime  // dia do destinatário (folga a ceder)
  motivo          String?
  estado          String    @default("pendente") // pendente|aceite|recusado|aprovado|cancelado
  aprovadoPorId   String?
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  solicitante  Utilizador  @relation("TrocaFolgaSolicitante",  fields: [solicitanteId],  references: [id], onDelete: Cascade)
  destinatario Utilizador  @relation("TrocaFolgaDestinatario", fields: [destinatarioId], references: [id], onDelete: Cascade)
  aprovadoPor  Utilizador? @relation("TrocaFolgaAprovador",    fields: [aprovadoPorId],  references: [id], onDelete: SetNull)

  @@index([solicitanteId])
  @@index([destinatarioId])
  @@index([estado])
  @@map("trocas_folga")
}

model FormacaoUtilizador {
  id             String      @id @default(uuid())
  utilizadorId   String
  utilizador     Utilizador  @relation("FormacaoUtilizador", fields: [utilizadorId], references: [id], onDelete: Cascade)
  nome           String
  dataRealizacao DateTime
  dataExpiracao  DateTime?
  entidade       String?
  obrigatoria    Boolean     @default(false)
  criadoEm       DateTime    @default(now())

  @@index([utilizadorId])
  @@map("formacoes_utilizadores")
}

// ─── Eventos Adversos ─────────────────────────────────────────────────────────

model EventoAdverso {
  id               String      @id @default(uuid())
  tipo             String      // 'queda' | 'erro_medicacao' | 'near_miss' | 'infecao' | 'lesao_pressao' | 'outro'
  gravidade        String      // 'sem_dano' | 'dano_leve' | 'dano_moderado' | 'dano_grave' | 'obito'
  descricao        String
  servicoId        String?     // servico onde ocorreu (enum Servico como string)
  doenteId         String?
  doente           Doente?     @relation("EventosAdversosDoente", fields: [doenteId], references: [id], onDelete: SetNull)
  registadoPorId   String?
  registadoPor     Utilizador? @relation("EventoAdversoRegistado", fields: [registadoPorId], references: [id], onDelete: SetNull)
  acaoCorretiva    String?
  estado           String      @default("aberto") // 'aberto' | 'em_investigacao' | 'encerrado'
  ocorridoEm       DateTime    @default(now())
  criadoEm         DateTime    @default(now())
  atualizadoEm     DateTime    @updatedAt

  @@index([tipo])
  @@index([gravidade])
  @@index([estado])
  @@index([ocorridoEm])
  @@map("eventos_adversos")
}

// ─── Especialidades Clínicas (Nutrição, Psicologia, Terapia da Fala, TAE) ────

model SessaoEspecialidade {
  id             String   @id @default(uuid())
  tipo           String   // 'nutricao' | 'psicologia' | 'terapia_fala' | 'tae'
  doenteId       String
  profissionalId String
  data           DateTime
  duracao        Int      // minutos
  descricao      String?
  evolucao       String?
  estado         String   @default("agendada") // agendada | realizada | cancelada | faltou
  criadoEm      DateTime @default(now())

  doente        Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  profissional  Utilizador @relation("SessaoEspecialidadeProfissional", fields: [profissionalId], references: [id], onDelete: Cascade)

  @@index([profissionalId, data])
  @@index([doenteId])
  @@map("sessoes_especialidade")
}

// ─── RH Expandido ─────────────────────────────────────────────────────────────

model AvaliacaoDesempenho {
  id             String   @id @default(uuid())
  utilizadorId   String
  avaliadorId    String
  periodo        String   // "2025-Anual", "2026-S1"
  dataAvaliacao  DateTime
  pontuacaoGeral Int      // 1-5
  pontosFortes   String?
  areasMelhoria  String?
  observacoes    String?
  estado         String   @default("rascunho") // rascunho | finalizada | assinada
  criadoEm      DateTime @default(now())

  utilizador    Utilizador @relation("AvaliacaoAvaliado",  fields: [utilizadorId], references: [id], onDelete: Cascade)
  avaliador     Utilizador @relation("AvaliacaoAvaliador", fields: [avaliadorId],  references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@index([avaliadorId])
  @@map("avaliacoes_desempenho")
}

model DadosContratuais {
  id               String    @id @default(uuid())
  utilizadorId     String    @unique
  tipoVinculo      String    // 'permanente' | 'termo_certo' | 'prestacao_servicos' | 'estagio'
  dataInicio       DateTime
  dataFimPrevista  DateTime?
  diasFeriasAnuais Int       @default(22)
  criadoEm        DateTime  @default(now())
  atualizadoEm    DateTime  @updatedAt

  utilizador       Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@map("dados_contratuais")
}

// ─── Consentimento Informado ──────────────────────────────────────────────────

model ConsentimentoInformado {
  id                       String     @id @default(uuid())
  doenteId                 String
  doente                   Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo                     String     // cirurgia | procedimento_invasivo | anestesia | transfusao | outro
  descricao                String
  assinadoDoenteEm         DateTime?
  assinadoTestemunhaEm     DateTime?
  testemunhaId             String?
  testemunha               Utilizador? @relation("ConsentimentoTestemunha", fields: [testemunhaId], references: [id], onDelete: SetNull)
  recusado                 Boolean    @default(false)
  motivoRecusa             String?
  criadoEm                 DateTime   @default(now())
  criadoPorId              String
  criadoPor                Utilizador @relation("ConsentimentoCriador", fields: [criadoPorId], references: [id], onDelete: Cascade)

  @@index([doenteId])
  @@index([tipo])
  @@map("consentimentos_informados")
}

// ─── Break-Glass Access ───────────────────────────────────────────────────────

model BreakGlassAccess {
  id            String     @id @default(uuid())
  utilizadorId  String
  utilizador    Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)
  doenteId      String
  doente        Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  motivo        String
  ip            String?
  ativo         Boolean    @default(true)
  criadoEm      DateTime   @default(now())
  expiradoEm    DateTime

  @@index([utilizadorId, doenteId, ativo])
  @@index([expiradoEm])
  @@map("break_glass_access")
}

// ─── Protocolos Clínicos ──────────────────────────────────────────────────────

model ProtocoloClinico {
  id            String     @id @default(uuid())
  doenteId      String
  doente        Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo          String     // sepsis | avc | iamcst | outro
  estadoGeral   String     @default("ativo") // ativo | concluido | cancelado
  ativadoPorId  String?
  ativadoPor    Utilizador? @relation(fields: [ativadoPorId], references: [id], onDelete: SetNull)
  criadoEm      DateTime   @default(now())
  itens         ItemProtocolo[]

  @@index([doenteId, estadoGeral])
  @@index([tipo, estadoGeral])
  @@map("protocolos_clinicos")
}

model ItemProtocolo {
  id              String           @id @default(uuid())
  protocoloId     String
  protocolo       ProtocoloClinico @relation(fields: [protocoloId], references: [id], onDelete: Cascade)
  descricao       String
  prazo           Int?             // minutos desde criação do protocolo
  concluido       Boolean          @default(false)
  concluidoEm     DateTime?
  concluidoPorId  String?
  concluidoPor    Utilizador?      @relation(fields: [concluidoPorId], references: [id], onDelete: SetNull)

  @@index([protocoloId])
  @@map("itens_protocolo")
}

// ─── Dietética ────────────────────────────────────────────────────────────────

model PrescricaoDieta {
  id           String     @id @default(uuid())
  doenteId     String
  doente       Doente     @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  tipo         String     // normal | hipocalorica | diab | renal | hepatica | liquida | jejum | outra
  restricoes   String[]
  observacoes  String?
  ativa        Boolean    @default(true)
  criadaEm     DateTime   @default(now())
  criadaPorId  String
  criadaPor    Utilizador @relation(fields: [criadaPorId], references: [id], onDelete: Cascade)

  @@index([doenteId, ativa])
  @@map("prescricoes_dieta")
}

// ─── IACS — Culturas Microbiológicas e Surtos ─────────────────────────────────

enum ResultadoCultura {
  pendente
  positivo
  negativo
  contaminado
}

model CulturaMicrobiologica {
  id             String           @id @default(uuid())
  doenteId       String
  doente         Doente           @relation(fields: [doenteId], references: [id], onDelete: Cascade)
  dataColheita   DateTime
  tipoAmostra    String
  agente         String?
  antibiograma   Json?
  resultado      ResultadoCultura @default(pendente)
  servico        String?
  observacoes    String?
  registadoPorId String
  registadoPor   Utilizador       @relation(fields: [registadoPorId], references: [id], onDelete: Cascade)
  criadoEm       DateTime         @default(now())

  @@index([doenteId])
  @@index([resultado])
  @@index([agente])
  @@map("culturas_microbiologicas")
}

enum EstadoSurto {
  activo
  controlado
  encerrado
}

model SurtoIACS {
  id             String      @id @default(uuid())
  agente         String
  servico        String
  dataInicio     DateTime
  dataFim        DateTime?
  estado         EstadoSurto @default(activo)
  numCasos       Int         @default(1)
  medidas        Json?
  observacoes    String?
  registadoPorId String
  registadoPor   Utilizador  @relation(fields: [registadoPorId], references: [id], onDelete: Cascade)
  criadoEm       DateTime    @default(now())

  @@index([estado])
  @@index([agente])
  @@map("surtos_iacs")
}

// ─── Conformidade / RGPD Checklist ───────────────────────────────────────────

model ConformidadeChecklistItem {
  id              String      @id @default(uuid())
  itemKey         String      @unique
  estado          String      @default("verificar") // 'conforme' | 'verificar' | 'nao_conforme'
  atualizadoEm   DateTime    @updatedAt
  atualizadoPorId String?
  atualizadoPor   Utilizador? @relation("ChecklistAtualizador", fields: [atualizadoPorId], references: [id], onDelete: SetNull)

  @@map("conformidade_checklist")
}
