{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // A app corre também em react-native-web, e vários ecrãs usam `window.alert`/
    // `window.confirm` guardados por `Platform.OS === 'web'`. O `tsconfig.base.json`
    // declara apenas `lib: ["es2022"]` e é partilhado por api e web — a lib DOM tem de
    // ser acrescentada aqui, localmente, e não lá.
    "lib": ["es2022", "dom"],
    "outDir": "dist",
    "types": ["node"],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "noUnusedLocals": false,
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "paths": {
      "@org/shared": ["../../libs/shared/src/index.ts"]
    }
  },
  "files": ["../../node_modules/@nx/expo/typings/svg.d.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/*.test.tsx",
    "**/*.spec.tsx",
    "**/*.test.js",
    "**/*.spec.js",
    "**/*.test.jsx",
    "**/*.spec.jsx",
    "src/test-setup.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    "**/*.jsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "references": [
    {
      "path": "../../libs/shared/tsconfig.lib.json"
    }
  ]
}
