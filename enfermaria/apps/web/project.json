{
  "name": "@org/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build --webpack --experimental-build-mode=compile",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    }
  }
}
