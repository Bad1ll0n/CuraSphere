{
  "name": "@org/web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next build --webpack --experimental-build-mode=compile",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p tsconfig.json --noEmit",
        "cwd": "{projectRoot}"
      },
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["default", "^default"]
    }
  }
}
