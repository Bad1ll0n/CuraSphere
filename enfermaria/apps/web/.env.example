# URL da API backend (OBRIGATÓRIO em produção)
NEXT_PUBLIC_API_URL=http://localhost:3333

# Sentry DSN — monitorização de erros em produção (opcional)
NEXT_PUBLIC_SENTRY_DSN=

# JWT — OBRIGATÓRIO em produção. TEM de ser EXACTAMENTE igual ao JWT_SECRET da API:
# o middleware Next.js (src/middleware.ts) verifica a assinatura do access_token
# server-side (HS256) antes de deixar passar pedidos autenticados.
JWT_SECRET="CHANGE_ME_use_openssl_rand_hex_32_to_generate_strong_secret"

# Sentry — token de auth para upload de source maps no build (opcional; sem isto o
# upload de source maps é desactivado automaticamente, ver next.config.js)
SENTRY_AUTH_TOKEN=
