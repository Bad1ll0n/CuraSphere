# ─────────────────────────────────────────────────────────────────────────────
# CuraSphere — Variáveis de Ambiente (copiar para .env.prod e preencher)
#
#   cp .env.example .env.prod && $EDITOR .env.prod
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# ⚠ O Docker Compose NÃO interpola variáveis dentro de um ficheiro de ambiente.
#   `DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@...` chegava ao
#   contentor com o texto literal `${DB_USER}` lá dentro, e o Prisma tentava
#   autenticar-se com um utilizador chamado "${DB_USER}". Todos os valores
#   abaixo são LITERAIS: se mudar a password, muda-a nos dois sítios.
#   (Interpolação só funciona no docker-compose.yml, não aqui.)
#
# ⚠ Marcação usada abaixo:
#   [OBRIGATÓRIA]  o `docker compose up` RECUSA arrancar sem ela, com mensagem.
#                  É deliberado: o projecto prefere falhar alto a degradar em
#                  silêncio (mesmo padrão do Joi em apps/api/src/app/app.module.ts).
#   [opcional]     omitir desliga a funcionalidade, de forma segura e conhecida.
#
# ⚠ Este ficheiro é um MODELO e vai para o repositório. NUNCA escrever segredos
#   reais aqui — só em .env.prod, que está no .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=enfermaria
# [OBRIGATÓRIA]
DB_USER=curasphere
# [OBRIGATÓRIA]
DB_PASSWORD=ALTERAR_PASSWORD_FORTE_AQUI

# URL completa usada pelo Prisma CLI a partir do HOST (migrações, db push,
# scripts de manutenção). Dentro do compose, a API recebe a sua própria
# DATABASE_URL construída no docker-compose.prod.yml — não é esta.
# LITERAL, sem ${...}: manter em sincronia com os cinco valores acima.
DATABASE_URL=postgresql://curasphere:ALTERAR_PASSWORD_FORTE_AQUI@postgres:5432/enfermaria?schema=public

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
# [OBRIGATÓRIA] mínimo 32 chars
JWT_SECRET=ALTERAR_SECRET_MINIMO_32_CHARS_AQUI
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Origens CORS permitidas (separadas por vírgula) ───────────────────────────
# ALTERAR para o domínio real do hospital
# [OBRIGATÓRIA] em produção
ALLOWED_ORIGINS=https://curasphere.hospital.pt

# ── URLs públicos ─────────────────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL é BUILD-ARG: fica cozido no bundle do Next.js. Alimenta o
# URL do WebSocket (src/lib/use-socket.ts) e o `connect-src` do CSP
# (next.config.js). Mudar isto exige reconstruir a imagem do web, não reiniciar.
# [OBRIGATÓRIA]
NEXT_PUBLIC_API_URL=https://curasphere.hospital.pt/api
# Lido pela API em auth/sso/sso.controller.ts para o redirect pós-SSO.
# Sem ele o código usa 'http://localhost:4200' e o SSO em produção devolve os
# utilizadores autenticados para localhost.
# [OBRIGATÓRIA]
NEXT_PUBLIC_WEB_URL=https://curasphere.hospital.pt

# ── Cache Redis ───────────────────────────────────────────────────────────────
# Em desenvolvimento, omitir ou usar redis://localhost:6379
# Em produção, o docker-compose define automaticamente redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
# [opcional] true só em dev
LOG_PRETTY=false

# ── Encriptação de PII em repouso (AES-256-GCM) ───────────────────────────────
# Gerar com: openssl rand -hex 32   (64 caracteres hex)
# [OBRIGATÓRIA] Sem ela o middleware de encriptação faz no-op SILENCIOSO e o
# nome/contacto/morada dos doentes ficam em texto simples na base de dados.
# AVISO: após activar, correr o script de re-encriptação dos dados existentes.
# ⚠ PERDER ESTA CHAVE = PII DOS DOENTES IRRECUPERÁVEL, mesmo com o backup.
#   Guardar num gestor de segredos com backup próprio. Ver DR-RUNBOOK.md §2.
ENCRYPTION_KEY=

# ── Assinatura da auditoria (tamper-proof) ────────────────────────────────────
# Gerar com: openssl rand -hex 32
# [OBRIGATÓRIA] Sem ela, common/audit-checkpoint.service.ts assina os
# checkpoints com a chave por omissão 'dev-insecure-audit-signing-key-change-me',
# que está PUBLICADA no repositório — qualquer pessoa pode forjar um checkpoint
# que valide dados adulterados. O serviço regista um erro mas arranca na mesma,
# por isso a falha é invisível em produção.
# Guardar FORA da base de dados (um DBA não pode ter acesso a esta chave).
AUDIT_SIGNING_KEY=
# Intervalo de selagem dos checkpoints (ms).
AUDIT_CHECKPOINT_MS=60000
# Sink append-only fora da BD. Por omissão vai para dentro do volume de uploads,
# para sobreviver ao deploy e entrar na rotina de cópia. Em produção a sério,
# apontar para armazenamento WORM (S3 object-lock).
AUDIT_ANCHOR_FILE=/app/uploads/audit-anchor.jsonl

# ── Quiosque de doente ────────────────────────────────────────────────────────
# [opcional] Obrigatória SE o quiosque estiver activo — a API lança erro ao
# gerar/validar tokens de quiosque sem isto. Gerar: openssl rand -hex 32
QUIOSQUE_SECRET=
# [opcional] Idade máxima de um token de quiosque, em dias (SEC-17). Vazio usa a
# omissão definida no código.
QUIOSQUE_TOKEN_MAX_DIAS=

# ── Métricas (Prometheus) ─────────────────────────────────────────────────────
# [opcional, mas ver aviso] Bearer token de scraping do /metrics.
# common/metrics-scrape.guard.ts falha FECHADO em produção: sem este token o
# endpoint devolve 401 e o sistema fica SEM MÉTRICAS NENHUMAS — a recolha existe
# mas ninguém a consegue ler. Definir se houver Prometheus.
# Gerar: openssl rand -hex 32
METRICS_TOKEN=

# ── Assinatura das etiquetas QR de medicação ──────────────────────────────────
# [opcional] Se vazia, medicacao.service.ts reutiliza o JWT_SECRET (omissão
# segura). Preferível uma chave dedicada. Gerar: openssl rand -hex 32
MEDICACAO_QR_SECRET=

# ── Armazenamento de objectos (documentos, DICOM, PDFs de alta) ───────────────
# 'local' guarda em /app/uploads dentro do contentor, persistido pelo volume
# nomeado `api_uploads` (docker-compose.prod.yml). 's3' ou 'minio' exigem as
# credenciais respectivas — sem elas os uploads falham em runtime.
STORAGE_PROVIDER=local
S3_BUCKET=curasphere
AWS_REGION=eu-west-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# MinIO (alternativa self-hosted ao S3)
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_BUCKET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# ── Teleconsulta (Jitsi) ──────────────────────────────────────────────────────
# [OBRIGATÓRIA] A omissão no código é o servidor PÚBLICO https://meet.jit.si —
# consultas clínicas a atravessar infraestrutura de terceiros sem contrato de
# subcontratação nem base legal RGPD. Apontar para o Jitsi da instituição.
# São DUAS variáveis, lidas em sítios diferentes, e as duas têm a mesma omissão
# perigosa: a API usa JITSI_SERVER (consultas.service.ts, portal-doente) e o
# frontend usa NEXT_PUBLIC_JITSI_SERVER (página de teleconsulta). Definir AMBAS,
# com o mesmo valor. A do frontend é BUILD-ARG: mudá-la exige reconstruir a imagem.
JITSI_SERVER=https://jitsi.hospital.pt
# [OBRIGATÓRIA]
NEXT_PUBLIC_JITSI_SERVER=https://jitsi.hospital.pt

# ── SPMS / SNS (interoperabilidade FHIR + PEM) ────────────────────────────────
# [OBRIGATÓRIA] A omissão no código é api-staging.spms.min-saude.pt.
# Produção a falar com o ambiente de staging do SNS é uma falha silenciosa.
SPMS_API_URL=https://api.spms.min-saude.pt
# [opcional]
SPMS_API_KEY=
# [OBRIGATÓRIA] 'sandbox' (simulador) ou o modo real. A omissão é 'sandbox':
# em produção, receitas que ninguém consegue levantar na farmácia.
SNS_PEM_MODE=sandbox
# [opcional]
SNS_PEM_ENDPOINT=

# ── HL7 (recepção de mensagens) ───────────────────────────────────────────────
# [opcional] Vazio = integração HL7 desligada. O controlador falha FECHADO
# (401 em /hl7/receive) quando está vazio, por isso a omissão é segura.
HL7_API_TOKEN=

# ── IA Clínica (Claude / Anthropic) ───────────────────────────────────────────
# [opcional] Necessária para: AI Clínico e stewardship antibiótico
# (de-escalação automática). Sem ela essas funcionalidades ficam desligadas.
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── OpenAI (embeddings para busca semântica de guidelines) ────────────────────
# [opcional] Sem esta chave, a busca cai em keyword cosine similarity.
OPENAI_API_KEY=

# ── Email transaccional (Resend) ──────────────────────────────────────────────
# [opcional] Sem RESEND_API_KEY o mailer regista um aviso e IGNORA o envio — os
# relatórios de turno deixam de sair sem nada falhar de forma visível.
RESEND_API_KEY=
MAIL_DOMAIN=curasphere.pt
# Destinatários do relatório de turno, separados por vírgula.
RELATORIO_TURNO_EMAILS=

# ── Geofencing de picagem de turnos ───────────────────────────────────────────
# [opcional, mas ver aviso] turnos.service.ts faz parseFloat(HOSPITAL_LAT ?? '0'):
# sem estes valores o hospital fica em (0, 0) — ao largo da Guiné — e a validação
# de picagem por localização rejeita toda a gente. Preencher OU desligar a
# funcionalidade; não deixar a meio.
HOSPITAL_LAT=
HOSPITAL_LON=
HOSPITAL_GEOFENCE_METROS=500

# ── Limites de pedidos ────────────────────────────────────────────────────────
# pedidos/min, global
THROTTLE_LIMIT=60
# tentativas de login por 10 min
LOGIN_THROTTLE_LIMIT=5

# ── Sentry (Error Monitoring) — opcional, mas recomendado em produção ─────────
# Criar conta em sentry.io → New Project → Node.js (API) e Next.js (Web)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Opcional: para upload de source maps (melhora stack traces em produção)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Tracing OpenTelemetry ─────────────────────────────────────────────────────
# [opcional] Vazio = tracing desligado (gated em apps/api/src/tracing.ts).
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Backups ───────────────────────────────────────────────────────────────────
# [opcional, FORTEMENTE recomendado] Chave de encriptação dos backups em repouso
# (AES-256). Gerar: openssl rand -hex 32
# Sem ela, `backup-all.sh` escreve dumps EM CLARO com toda a PII dos doentes,
# no mesmo host que a base de dados. Ver DR-RUNBOOK.md §3.
# ⚠ Guardar esta chave FORA do host de backups — se se perder, os backups
#   encriptados são irrecuperáveis.
BACKUP_ENCRYPTION_KEY=
# Dias de retenção dos backups locais.
RETENCAO_DIAS=30

# ── Escala horizontal da API ──────────────────────────────────────────────────
# Número de réplicas do serviço `api`. A aplicação suporta >1 (leader-election
# nos crons + adaptador Redis do socket.io). Ver OPS-12 e as notas de capacidade
# em docker-compose.prod.yml antes de subir este valor.
API_REPLICAS=1
