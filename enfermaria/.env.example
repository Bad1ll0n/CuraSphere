# ─────────────────────────────────────────────────────────────────────────────
# CuraSphere — Variáveis de Ambiente (copiar para .env.prod e preencher)
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=enfermaria
DB_USER=curasphere
DB_PASSWORD=ALTERAR_PASSWORD_FORTE_AQUI

# URL completa usada pelo Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=ALTERAR_SECRET_MINIMO_32_CHARS_AQUI
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Origens CORS permitidas (separadas por vírgula) ───────────────────────────
# ALTERAR para o domínio real do hospital
ALLOWED_ORIGINS=https://curasphere.hospital.pt

# ── URL pública da API (usada pelo frontend no browser) ──────────────────────
# Com Nginx: caminho relativo ao domínio
NEXT_PUBLIC_API_URL=https://curasphere.hospital.pt/api

# ── Cache Redis ───────────────────────────────────────────────────────────────
# Em desenvolvimento, omitir ou usar redis://localhost:6379
# Em produção, o docker-compose define automaticamente redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333
