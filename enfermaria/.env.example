# ─────────────────────────────────────────────────────────────────────────────
# CuraSphere — Variáveis de Ambiente (copiar para .env.prod e preencher)
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de dados ─────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=enfermaria
DB_USER=curasphere
DB_PASSWORD=ALTERAR_PASSWORD_FORTE_AQUI

# URL completa usada pelo Prisma
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 32
JWT_SECRET=ALTERAR_SECRET_MINIMO_32_CHARS_AQUI
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ── Origens CORS permitidas (separadas por vírgula) ───────────────────────────
# ALTERAR para o domínio real do hospital
ALLOWED_ORIGINS=https://curasphere.hospital.pt

# ── URL pública da API (usada pelo frontend no browser) ──────────────────────
# Com Nginx: caminho relativo ao domínio
NEXT_PUBLIC_API_URL=https://curasphere.hospital.pt/api

# ── Cache Redis ───────────────────────────────────────────────────────────────
# Em desenvolvimento, omitir ou usar redis://localhost:6379
# Em produção, o docker-compose define automaticamente redis://redis:6379
REDIS_URL=redis://localhost:6379

# ── Servidor ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3333

# ── IA Clínica (Claude / Anthropic) ─────────────────────────────────────────
# Obrigatório para: AI Clínico, Stewardship antibiótico (de-escalação automática)
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-ALTERAR_AQUI

# ── OpenAI (Embeddings para busca semântica de guidelines) — opcional ─────────
# Sem esta chave, a busca usa keyword cosine similarity como fallback
# Obter em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-ALTERAR_AQUI

# ── Sentry (Error Monitoring) — opcional, mas recomendado em produção ─────────
# Criar conta gratuita em sentry.io → New Project → Node.js (API) e Next.js (Web)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
# Opcional: para upload de source maps (melhora stack traces em produção)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Encriptação PII (AES-256-GCM) — gerar com: openssl rand -hex 32
# AVISO: após activar, correr migration script para re-encriptar dados existentes
ENCRYPTION_KEY=
